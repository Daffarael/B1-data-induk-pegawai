<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>FacultyWare</title>

    <!-- Basecoat UI - komponen dasar -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/basecoat-css@0.3.11/dist/basecoat.cdn.min.css">
    <script src="https://cdn.jsdelivr.net/npm/basecoat-css@0.3.11/dist/js/all.min.js" defer></script>

    <!-- Custom Design System FacultyWare -->
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="app-layout">

        <!-- Sidebar navigasi -->
        <%- include('../partials/sidebar') %>

        <!-- Area konten utama -->
        <div class="app-main">

            <!-- Header atas -->
            <%- include('../partials/header') %>

            <!-- Isi halaman -->
            <main class="app-content">
                <!-- Flash messages -->
                <%- include('../partials/flash') %>

                <!-- Konten halaman (diisi oleh masing-masing view) -->
                <%- body %>
            </main>
        </div>
    </div>

    <!-- ═══ Global Delete Confirmation Modal ═══ -->
    <div id="fw-delete-modal" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.5); z-index:9999; align-items:center; justify-content:center;">
      <div style="background:#fff; border:1px solid #e2e8f0; border-radius:0.75rem; padding:1.5rem; width:100%; max-width:400px; margin:1rem; box-shadow:0 20px 60px rgba(0,0,0,0.15); animation:fw-modal-in 0.15s ease;">
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <div style="background:#fee2e2; border-radius:50%; width:40px; height:40px; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:2px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
          </div>
          <div style="flex:1;">
            <div style="font-size:0.9375rem; font-weight:600; color:#0f172a; margin-bottom:0.375rem;">Hapus Data</div>
            <div id="fw-delete-msg" style="font-size:0.8125rem; color:#64748b; line-height:1.6;"></div>
          </div>
        </div>
        <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:1.25rem; padding-top:1rem; border-top:1px solid #f1f5f9;">
          <button type="button" class="fw-btn fw-btn-ghost fw-btn-sm" onclick="fwCloseDeleteModal()">Batal</button>
          <form id="fw-delete-form" method="POST" action="" style="display:inline;">
            <input type="hidden" name="_method" value="DELETE">
            <button type="submit" class="fw-btn fw-btn-danger fw-btn-sm">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
              Hapus
            </button>
          </form>
        </div>
      </div>
    </div>

    <style>
    @keyframes fw-modal-in {
      from { opacity:0; transform:scale(0.95) translateY(-8px); }
      to   { opacity:1; transform:scale(1)    translateY(0);     }
    }
    </style>
    <script>
    function fwShowDeleteModal(action, name) {
      document.getElementById('fw-delete-form').action = action;
      document.getElementById('fw-delete-msg').innerHTML =
        'Yakin ingin menghapus <strong style="color:#0f172a;">' + name + '</strong>?<br>' +
        '<span style="font-size:0.75rem; color:#94a3b8;">Tindakan ini tidak dapat dibatalkan.</span>';
      const modal = document.getElementById('fw-delete-modal');
      modal.style.display = 'flex';
    }
    function fwCloseDeleteModal() {
      document.getElementById('fw-delete-modal').style.display = 'none';
    }
    document.addEventListener('DOMContentLoaded', function() {
      document.getElementById('fw-delete-modal').addEventListener('click', function(e) {
        if (e.target === this) fwCloseDeleteModal();
      });
    });
    </script>
</body>
</html>