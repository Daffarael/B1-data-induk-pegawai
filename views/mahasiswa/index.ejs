<%# views/mahasiswa/index.ejs %>

<style>
  .pg-stat-card   { display:flex; flex-direction:column; gap:0.375rem; padding:1.125rem 1.25rem; border-radius:12px; border:1px solid #e4e4e7; background:#fff; min-width:0; }
  .pg-stat-label  { font-size:0.6875rem; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; color:#71717a; }
  .pg-stat-number { font-size:1.75rem; font-weight:700; color:#18181b; line-height:1; }
  .pg-stat-sub    { font-size:0.75rem; color:#a1a1aa; }
  .pg-stat-icon   { width:34px; height:34px; border-radius:9px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .pg-table th    { height:36px; padding:0 1rem; text-align:left; font-size:0.65rem; font-weight:600; color:#a1a1aa; text-transform:uppercase; letter-spacing:0.06em; white-space:nowrap; }
  .pg-table th.center { text-align:center; }
  .pg-table td    { padding:0.75rem 1rem; font-size:0.8125rem; vertical-align:middle; }
  .pg-table tr    { border-bottom:1px solid #f4f4f5; transition:background 0.1s; }
  .pg-table tr:last-child { border-bottom:none; }
  .pg-table tr:hover { background:#fafafa; }
  .action-btn     { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:7px; color:#a1a1aa; transition:all 0.1s; border:none; background:transparent; cursor:pointer; text-decoration:none; }
  .action-btn:hover       { background:#f4f4f5; color:#18181b; }
  .action-btn.view:hover  { background:#eef2ff; color:#6366f1; }
  .action-btn.edit:hover  { background:#fffbeb; color:#d97706; }
  .action-btn.del:hover   { background:#fef2f2; color:#dc2626; }
  .status-badge   { display:inline-flex; align-items:center; gap:4px; border-radius:999px; padding:2px 10px; font-size:0.7rem; font-weight:500; border:1px solid; }
  .pg-num         { display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; border-radius:7px; border:1px solid #e4e4e7; font-size:0.75rem; color:#52525b; text-decoration:none; background:#fff; transition:all 0.1s; }
  .pg-num:hover   { background:#f4f4f5; }
  .pg-num.active  { background:#18181b; border-color:#18181b; color:#fff; }
</style>

<%# ── Stats ── %>
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.25rem;">

  <div class="pg-stat-card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.375rem;">
      <span class="pg-stat-label">Total Mahasiswa</span>
      <div class="pg-stat-icon" style="background:#eef2ff;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.75"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
    </div>
    <div class="pg-stat-number"><%= total %></div>
    <div class="pg-stat-sub">terdaftar</div>
  </div>

  <div class="pg-stat-card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.375rem;">
      <span class="pg-stat-label">Aktif</span>
      <div class="pg-stat-icon" style="background:#f0fdf4;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="1.75"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
    </div>
    <div class="pg-stat-number"><%= totalAktif %></div>
    <div class="pg-stat-sub">mahasiswa aktif</div>
  </div>

  <div class="pg-stat-card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.375rem;">
      <span class="pg-stat-label">Cuti</span>
      <div class="pg-stat-icon" style="background:#fffbeb;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="1.75"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
    </div>
    <div class="pg-stat-number"><%= totalCuti %></div>
    <div class="pg-stat-sub">sedang cuti</div>
  </div>

  <div class="pg-stat-card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.375rem;">
      <span class="pg-stat-label">Lulus</span>
      <div class="pg-stat-icon" style="background:#f0f9ff;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="1.75"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
      </div>
    </div>
    <div class="pg-stat-number"><%= totalLulus %></div>
    <div class="pg-stat-sub">telah lulus</div>
  </div>

</div>

<%# ── Main Card ── %>
<div data-slot="card" class="rounded-xl border bg-card text-card-foreground shadow-sm">

  <%# Toolbar %>
  <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.625rem;padding:0.875rem 1.25rem;border-bottom:1px solid #f4f4f5;">
    <form method="GET" action="/mahasiswa" style="display:flex;flex-wrap:wrap;align-items:center;gap:0.5rem;flex:1;">
      <div style="position:relative;flex:1;min-width:180px;max-width:260px;">
        <svg style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:#a1a1aa;" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" name="search" value="<%= search %>" placeholder="Cari nama atau NIM..."
          data-slot="input"
          style="height:32px;padding-left:30px;padding-right:10px;font-size:0.8125rem;"
          class="w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
      </div>
      <select name="status" data-slot="input"
        style="height:32px;padding:0 8px;font-size:0.8125rem;border-radius:8px;min-width:130px;"
        class="rounded-md border border-input bg-background text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        <option value="">Semua Status</option>
        <% Object.entries(statusMap).forEach(([key, val]) => { %>
          <option value="<%= key %>" <%= statusFilter === key ? 'selected' : '' %>><%= val %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn-sm" style="height:32px;padding:0 14px;font-size:0.8125rem;">Cari</button>
      <a href="/mahasiswa" class="btn-sm-outline" style="height:32px;padding:0 14px;font-size:0.8125rem;">Reset</a>
    </form>
    <div style="display:flex;align-items:center;gap:0.5rem;margin-left:auto;">
      <a href="/mahasiswa/export/pdf/preview?search=<%= encodeURIComponent(search) %>&status=<%= statusFilter %>"
        class="btn-sm-outline" style="height:32px;padding:0 14px;font-size:0.8125rem;display:inline-flex;align-items:center;gap:6px;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Ekspor PDF
      </a>
      <a href="/mahasiswa/export/json/preview?search=<%= encodeURIComponent(search) %>&status=<%= statusFilter %>"
        class="btn-sm-outline" style="height:32px;padding:0 14px;font-size:0.8125rem;display:inline-flex;align-items:center;gap:6px;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        Ekspor JSON
      </a>
      <a href="/mahasiswa/create" class="btn" style="height:32px;padding:0 14px;font-size:0.8125rem;display:inline-flex;align-items:center;gap:6px;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tambah
      </a>
    </div>
  </div>

  <%# Import CSV %>
  <div style="padding:0.375rem 1rem;border-bottom:1px solid #f4f4f5;background:#fafafa;">
    <details>
      <summary style="font-size:0.7rem;color:#a1a1aa;cursor:pointer;display:flex;align-items:center;gap:6px;padding:4px 0;list-style:none;user-select:none;" class="hover:text-foreground transition-colors">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        Import dari CSV
      </summary>
      <div style="padding:0.625rem 0 0.375rem;">
        <form method="POST" action="/mahasiswa/import" enctype="multipart/form-data">
          <div style="display:flex;align-items:center;gap:0.625rem;flex-wrap:wrap;">
            <input type="file" name="file" accept=".csv" id="csvMhsFileInput"
              style="position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;clip:rect(0,0,0,0);">
            <label for="csvMhsFileInput" class="btn-sm-outline"
              style="height:32px;padding:0 0.875rem;font-size:0.75rem;display:inline-flex;align-items:center;gap:6px;cursor:pointer;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              Pilih File CSV
            </label>
            <span id="csvMhsFileName"
              style="font-size:0.7rem;color:#71717a;padding:0 0.625rem;height:32px;display:inline-flex;align-items:center;gap:5px;border:1px solid #e4e4e7;border-radius:6px;background:#fafafa;min-width:140px;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span id="csvMhsFileNameText" style="color:#a1a1aa;font-style:italic;">Belum ada file dipilih</span>
            </span>
            <button type="submit"
              style="height:32px;padding:0 0.875rem;font-size:0.75rem;background:#059669;color:#fff;border:none;border-radius:6px;display:inline-flex;align-items:center;gap:5px;font-weight:500;cursor:pointer;transition:background 0.12s;"
              onmouseover="this.style.background='#047857'" onmouseout="this.style.background='#059669'">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Upload & Import
            </button>
          </div>
          <p style="font-size:0.65rem;color:#a1a1aa;margin-top:8px;">
            Kolom wajib: <code style="background:#f4f4f5;padding:1px 5px;border-radius:4px;font-size:0.65rem;">regno, name, gender, year, status</code>
            &nbsp;· gender: <code style="background:#f4f4f5;padding:1px 5px;border-radius:4px;font-size:0.65rem;">1</code>=L, <code style="background:#f4f4f5;padding:1px 5px;border-radius:4px;font-size:0.65rem;">2</code>=P
            &nbsp;· status: <code style="background:#f4f4f5;padding:1px 5px;border-radius:4px;font-size:0.65rem;">1</code>=Aktif, <code style="background:#f4f4f5;padding:1px 5px;border-radius:4px;font-size:0.65rem;">2</code>=Cuti, <code style="background:#f4f4f5;padding:1px 5px;border-radius:4px;font-size:0.65rem;">3</code>=Lulus
          </p>
        </form>
        <script>
          document.getElementById('csvMhsFileInput').addEventListener('change', function() {
            const nameEl = document.getElementById('csvMhsFileNameText');
            if (this.files && this.files[0]) {
              nameEl.textContent = this.files[0].name;
              nameEl.style.color = '#18181b';
              nameEl.style.fontStyle = 'normal';
            } else {
              nameEl.textContent = 'Belum ada file dipilih';
              nameEl.style.color = '#a1a1aa';
              nameEl.style.fontStyle = 'italic';
            }
          });
        </script>
      </div>
    </details>
  </div>

  <%# Empty State %>
  <% if (!mahasiswa || mahasiswa.length === 0) { %>
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:4rem 1.5rem;text-align:center;">
      <div style="width:48px;height:48px;border-radius:12px;background:#f4f4f5;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <p style="font-size:0.875rem;font-weight:600;color:#18181b;margin:0 0 0.375rem;">Belum ada data mahasiswa</p>
      <p style="font-size:0.75rem;color:#a1a1aa;margin:0 0 1.25rem;">Klik "Tambah" untuk menambahkan data baru</p>
      <a href="/mahasiswa/create" class="btn" style="height:36px;padding:0 1.25rem;font-size:0.875rem;display:inline-flex;align-items:center;gap:6px;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tambah Mahasiswa
      </a>
    </div>
  <% } else { %>

    <%# Table %>
    <div style="overflow-x:auto;">
      <table class="pg-table" style="width:100%;border-collapse:collapse;">
        <thead style="background:#fafafa;border-bottom:1px solid #f4f4f5;">
          <tr>
            <th class="center" style="width:36px;">#</th>
            <th>NIM</th>
            <th>Nama Lengkap</th>
            <th>Program Studi</th>
            <th>L/P</th>
            <th>Angkatan</th>
            <th>Status</th>
            <th class="center" style="width:90px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% mahasiswa.forEach((m, i) => { %>
            <tr>
              <td style="text-align:center;color:#a1a1aa;font-size:0.7rem;"><%= (currentPage - 1) * 10 + i + 1 %></td>
              <td><code style="background:#f4f4f5;border-radius:4px;padding:2px 6px;font-family:monospace;font-size:0.75rem;"><%= m.regno %></code></td>
              <td style="font-weight:500;color:#18181b;"><%= m.name %></td>
              <td style="color:#71717a;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= m.department_name || '—' %></td>
              <td style="color:#71717a;"><%= m.gender_text %></td>
              <td style="color:#71717a;"><%= m.year || '—' %></td>
              <td>
                <% if (m.status === 1) { %>
                  <span class="status-badge" style="background:#f0fdf4;color:#16a34a;border-color:#bbf7d0;">● Aktif</span>
                <% } else if (m.status === 2) { %>
                  <span class="status-badge" style="background:#fffbeb;color:#d97706;border-color:#fde68a;">● Cuti</span>
                <% } else if (m.status === 3) { %>
                  <span class="status-badge" style="background:#eff6ff;color:#2563eb;border-color:#bfdbfe;">● Lulus</span>
                <% } else if (m.status === 4) { %>
                  <span class="status-badge" style="background:#f4f4f5;color:#71717a;border-color:#e4e4e7;">● Keluar</span>
                <% } else { %>
                  <span class="status-badge" style="background:#fef2f2;color:#dc2626;border-color:#fecaca;">● Drop Out</span>
                <% } %>
              </td>
              <td>
                <div style="display:flex;align-items:center;justify-content:center;gap:2px;">
                  <a href="/mahasiswa/<%= m.id %>" class="action-btn view" title="Detail">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  </a>
                  <a href="/mahasiswa/<%= m.id %>/edit" class="action-btn edit" title="Edit">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                  <button type="button" class="action-btn del" title="Hapus"
                    data-name="<%= m.name %>"
                    onclick="fwShowDeleteModal('/mahasiswa/<%= m.id %>', this.dataset.name)">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <%# Pagination %>
    <% if (totalPages > 1) { %>
      <div style="display:flex;justify-content:center;gap:4px;padding:0.875rem 1.25rem;border-top:1px solid #f4f4f5;">
        <% if (currentPage > 1) { %>
          <a href="/mahasiswa?page=<%= currentPage-1 %>&search=<%= encodeURIComponent(search) %>&status=<%= statusFilter %>" class="pg-num">‹</a>
        <% } %>
        <% for(let pg = Math.max(1, currentPage-2); pg <= Math.min(totalPages, currentPage+2); pg++) { %>
          <a href="/mahasiswa?page=<%= pg %>&search=<%= encodeURIComponent(search) %>&status=<%= statusFilter %>" class="pg-num<%= pg === currentPage ? ' active' : '' %>"><%= pg %></a>
        <% } %>
        <% if (currentPage < totalPages) { %>
          <a href="/mahasiswa?page=<%= currentPage+1 %>&search=<%= encodeURIComponent(search) %>&status=<%= statusFilter %>" class="pg-num">›</a>
        <% } %>
      </div>
    <% } %>

  <% } %>
</div>