<%# views/mahasiswa/index.ejs %>

<%# ── Stat cards ─────────────────────────────────────────── %>
<div class="fw-stats-grid">
  <div class="fw-stat">
    <div class="fw-stat-label">Total Mahasiswa</div>
    <div class="fw-stat-value"><%= total %></div>
    <div class="fw-stat-sub">terdaftar</div>
  </div>
  <div class="fw-stat">
    <div class="fw-stat-label">Aktif</div>
    <div class="fw-stat-value"><%= totalAktif %></div>
    <div class="fw-stat-sub">mahasiswa</div>
  </div>
  <div class="fw-stat">
    <div class="fw-stat-label">Cuti</div>
    <div class="fw-stat-value"><%= totalCuti %></div>
    <div class="fw-stat-sub">mahasiswa</div>
  </div>
  <div class="fw-stat">
    <div class="fw-stat-label">Lulus</div>
    <div class="fw-stat-value"><%= totalLulus %></div>
    <div class="fw-stat-sub">mahasiswa</div>
  </div>
</div>

<%# ── Main card ────────────────────────────────────────────── %>
<div class="fw-card">

  <%# Toolbar: search + filter + actions — semua sejajar satu baris %>
  <div class="fw-toolbar">
    <form method="GET" action="/mahasiswa" class="fw-toolbar-form">

      <%# Search input %>
      <div class="fw-toolbar-field fw-toolbar-search">
        <div class="fw-input-icon-wrap">
          <svg class="fw-input-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input type="text" name="search" value="<%= search %>"
                 placeholder="Cari nama atau NIM..."
                 class="fw-input fw-input-with-icon">
        </div>
      </div>

      <%# Status filter %>
      <div class="fw-toolbar-field">
        <select name="status" class="fw-select" style="width:150px;">
          <option value="">Semua Status</option>
          <% Object.entries(statusMap).forEach(([key, val]) => { %>
            <option value="<%= key %>" <%= statusFilter === key ? 'selected' : '' %>><%= val %></option>
          <% }) %>
        </select>
      </div>

      <%# Action buttons — sejajar dengan input %>
      <div class="fw-toolbar-actions">
        <button type="submit" class="fw-btn fw-btn-primary fw-btn-sm">Cari</button>
        <a href="/mahasiswa" class="fw-btn fw-btn-ghost fw-btn-sm">Reset</a>
      </div>
    </form>

    <%# Right-side buttons %>
    <div class="fw-toolbar-right">
      <a href="/mahasiswa/export/pdf?search=<%= encodeURIComponent(search) %>&status=<%= statusFilter %>"
         class="fw-btn fw-btn-outline fw-btn-sm" target="_blank">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
        </svg>
        Export PDF
      </a>
      <a href="/mahasiswa/export/json?search=<%= encodeURIComponent(search) %>&status=<%= statusFilter %>"
         class="fw-btn fw-btn-outline fw-btn-sm">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
        </svg>
        Export JSON
      </a>
      <a href="/mahasiswa/create" class="fw-btn fw-btn-primary fw-btn-sm">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Tambah
      </a>
    </div>

  </div>

  <%# Import CSV — row tersendiri di bawah toolbar %>
  <div class="fw-import-row">
    <details>
      <summary class="fw-import-toggle">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        Import dari CSV
      </summary>
      <div class="fw-import-body">
        <form method="POST" action="/mahasiswa/import" enctype="multipart/form-data" class="fw-import-form">
          <input type="file" name="file" accept=".csv" class="fw-import-file" required>
          <button type="submit" class="fw-btn fw-btn-sm" style="background:#10b981; color:#fff; border-color:#10b981;">
            Upload & Import
          </button>
        </form>
        <p class="fw-import-hint">
          Kolom wajib CSV: <code>regno, name, gender, year, status</code>
        </p>
      </div>
    </details>
  </div>

  <%# Divider %>
  <div class="fw-divider"></div>

  <%# Empty state %>
  <% if (!mahasiswa || mahasiswa.length === 0) { %>
    <div class="fw-empty">
      <svg class="fw-empty-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
      <div class="fw-empty-title">Belum ada data mahasiswa</div>
      <div class="fw-empty-desc">Klik "Tambah" untuk menambahkan data baru</div>
      <a href="/mahasiswa/create" class="fw-btn fw-btn-primary fw-btn-sm" style="margin-top:1rem;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tambah Mahasiswa
      </a>
    </div>

  <% } else { %>
    <%# Data table %>
    <div class="fw-table-wrap">
      <table class="fw-table">
        <thead>
          <tr>
            <th style="width:36px; text-align:center;">#</th>
            <th>NIM</th>
            <th>Nama Lengkap</th>
            <th>Program Studi</th>
            <th>L/P</th>
            <th>Angkatan</th>
            <th>Status</th>
            <th style="width:96px; text-align:center;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% mahasiswa.forEach((m, i) => { %>
            <tr>
              <td style="text-align:center; color:#c8ccda; font-size:0.75rem;"><%= (currentPage - 1) * 10 + i + 1 %></td>
              <td>
                <span class="fw-mono-chip"><%= m.regno %></span>
              </td>
              <td>
                <div class="fw-cell-name"><%= m.name %></div>
              </td>
              <td class="fw-cell-muted"><%= m.department_name || '—' %></td>
              <td class="fw-cell-muted"><%= m.gender_text %></td>
              <td class="fw-cell-muted"><%= m.year || '—' %></td>
              <td>
                <% if (m.status === 1) { %>
                  <span class="fw-badge fw-badge-green">● Aktif</span>
                <% } else if (m.status === 2) { %>
                  <span class="fw-badge fw-badge-yellow">● Cuti</span>
                <% } else if (m.status === 3) { %>
                  <span class="fw-badge fw-badge-blue">● Lulus</span>
                <% } else if (m.status === 4) { %>
                  <span class="fw-badge fw-badge-slate">● Keluar</span>
                <% } else { %>
                  <span class="fw-badge fw-badge-red">● Drop Out</span>
                <% } %>
              </td>
              <td>
                <div class="fw-action-btns">
                  <a href="/mahasiswa/<%= m.id %>" class="fw-action-btn" title="Detail">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  </a>
                  <a href="/mahasiswa/<%= m.id %>/edit" class="fw-action-btn fw-action-warn" title="Edit">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                  <button type="button" class="fw-action-btn fw-action-danger" title="Hapus"
                          onclick="fwShowDeleteModal('/mahasiswa/<%= m.id %>/delete', 'mahasiswa <%= m.name %>')">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <%# Footer: info + pagination %>
    <div class="fw-table-footer">
      <span class="fw-table-info">
        Menampilkan <%= (currentPage - 1) * 10 + 1 %>–<%= Math.min(currentPage * 10, total) %> dari <strong><%= total %></strong> data
      </span>
      <% if (totalPages > 1) { %>
        <div class="fw-pagination">
          <% if (currentPage > 1) { %>
            <a href="/mahasiswa?page=<%= currentPage-1 %>&search=<%= encodeURIComponent(search) %>&status=<%= statusFilter %>" class="fw-page-btn">‹</a>
          <% } %>
          <% for(let pg = Math.max(1, currentPage-2); pg <= Math.min(totalPages, currentPage+2); pg++) { %>
            <a href="/mahasiswa?page=<%= pg %>&search=<%= encodeURIComponent(search) %>&status=<%= statusFilter %>"
               class="fw-page-btn <%= pg === currentPage ? 'active' : '' %>"><%= pg %></a>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <a href="/mahasiswa?page=<%= currentPage+1 %>&search=<%= encodeURIComponent(search) %>&status=<%= statusFilter %>" class="fw-page-btn">›</a>
          <% } %>
        </div>
      <% } %>
    </div>
  <% } %>
</div>