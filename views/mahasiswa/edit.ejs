<%# views/mahasiswa/edit.ejs %>

<style>
  .fw-form-grid  { display:grid; grid-template-columns:1fr 1fr; gap:1.125rem; }
  .fw-form-full  { grid-column:1 / -1; }
  .fw-field-label{ display:block; font-size:0.6875rem; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; color:#71717a; margin-bottom:8px; }
  .fw-field-req  { color:#ef4444; }
  .fw-section-hdr{ display:flex; align-items:center; gap:10px; padding:1rem 1.5rem; border-bottom:1px solid #f4f4f5; }
  .fw-section-icon{ width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .fw-section-body{ padding:1.5rem; }
  .fw-input      { height:44px !important; padding:0 14px !important; font-size:0.9375rem !important; border-radius:8px !important; }
  .fw-select     { height:44px !important; padding:0 14px !important; font-size:0.9375rem !important; border-radius:8px !important; }
  .fw-textarea   { padding:12px 14px !important; font-size:0.9375rem !important; border-radius:8px !important; line-height:1.6 !important; }
  @media(max-width:640px){ .fw-form-grid{ grid-template-columns:1fr; } }
</style>

<%# ── Page Header ── %>
<div style="margin-bottom:1.5rem;">
  <a href="/mahasiswa/<%= m.id %>" style="display:inline-flex;align-items:center;gap:5px;font-size:0.75rem;color:#a1a1aa;text-decoration:none;margin-bottom:0.75rem;" onmouseover="this.style.color='#18181b'" onmouseout="this.style.color='#a1a1aa'">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
    Kembali ke Detail
  </a>
  <h1 style="font-size:1.125rem;font-weight:600;color:#18181b;margin:0 0 0.25rem;letter-spacing:-0.01em;">Edit Data Mahasiswa</h1>
  <p style="font-size:0.8125rem;color:#a1a1aa;margin:0;">Perbarui data induk mahasiswa: <strong style="color:#52525b;"><%= m.name %></strong></p>
</div>

<%# Error alert %>
<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div style="display:flex;gap:12px;padding:0.875rem 1rem;background:#fef2f2;border:1px solid #fecaca;border-radius:10px;margin-bottom:1.25rem;">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" style="flex-shrink:0;margin-top:1px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <div>
      <p style="font-size:0.8125rem;font-weight:600;color:#b91c1c;margin:0 0 0.375rem;">Terdapat <%= errors.length %> kesalahan</p>
      <ul style="margin:0;padding-left:1rem;font-size:0.75rem;color:#dc2626;">
        <% errors.forEach(e => { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  </div>
<% } %>

<% const fd = (typeof input !== 'undefined' && Object.keys(input).length > 0) ? input : m; %>
<% let bDate = ''; if (fd.birth_date) { const d = new Date(fd.birth_date); if (!isNaN(d)) bDate = d.toISOString().split('T')[0]; } %>

<form action="/mahasiswa/<%= m.id %>/update" method="POST" style="display:flex;flex-direction:column;gap:0.875rem;">

  <%# 1. Biodata Pribadi %>
  <div data-slot="card" class="rounded-xl border bg-card shadow-sm">
    <div class="fw-section-hdr">
      <div class="fw-section-icon" style="background:#eef2ff;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.75"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <span style="font-size:0.875rem;font-weight:600;color:#18181b;">Biodata Pribadi</span>
    </div>
    <div class="fw-section-body">
      <div class="fw-form-grid">

        <div class="fw-form-full">
          <label class="fw-field-label">NIM <span class="fw-field-req">*</span></label>
          <input type="text" name="regno" value="<%= fd.regno %>" required data-slot="input"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

        <div class="fw-form-full">
          <label class="fw-field-label">Nama Lengkap <span class="fw-field-req">*</span></label>
          <input type="text" name="name" value="<%= fd.name %>" required data-slot="input"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

        <div>
          <label class="fw-field-label">Tempat Lahir</label>
          <input type="text" name="birth_place" value="<%= fd.birth_place || '' %>" data-slot="input"
            placeholder="Kota kelahiran"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

        <div>
          <label class="fw-field-label">Tanggal Lahir <span class="fw-field-req">*</span></label>
          <input type="date" name="birth_date" value="<%= bDate %>" required data-slot="input"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

        <div>
          <label class="fw-field-label">Jenis Kelamin <span class="fw-field-req">*</span></label>
          <select name="gender" required data-slot="input"
            class="fw-select w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
            <option value="">- Pilih -</option>
            <option value="1" <%= fd.gender == 1 ? 'selected' : '' %>>Laki-laki</option>
            <option value="2" <%= fd.gender == 2 ? 'selected' : '' %>>Perempuan</option>
          </select>
        </div>

        <div>
          <label class="fw-field-label">Agama</label>
          <select name="religion" data-slot="input"
            class="fw-select w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
            <option value="">- Pilih -</option>
            <option value="1" <%= fd.religion == 1 ? 'selected' : '' %>>Islam</option>
            <option value="2" <%= fd.religion == 2 ? 'selected' : '' %>>Katolik</option>
            <option value="3" <%= fd.religion == 3 ? 'selected' : '' %>>Protestan</option>
            <option value="4" <%= fd.religion == 4 ? 'selected' : '' %>>Hindu</option>
            <option value="5" <%= fd.religion == 5 ? 'selected' : '' %>>Buddha</option>
            <option value="6" <%= fd.religion == 6 ? 'selected' : '' %>>Konghucu</option>
          </select>
        </div>

        <div class="fw-form-full">
          <label class="fw-field-label">Kewarganegaraan</label>
          <input type="text" name="citizenship" value="<%= fd.citizenship || 'Indonesia' %>" data-slot="input"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

      </div>
    </div>
  </div>

  <%# 2. Data Akademik & Kontak %>
  <div data-slot="card" class="rounded-xl border bg-card shadow-sm">
    <div class="fw-section-hdr">
      <div class="fw-section-icon" style="background:#f0fdf4;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="1.75"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
      </div>
      <span style="font-size:0.875rem;font-weight:600;color:#18181b;">Data Akademik & Kontak</span>
    </div>
    <div class="fw-section-body">
      <div class="fw-form-grid">

        <div class="fw-form-full">
          <label class="fw-field-label">Program Studi / Departemen <span class="fw-field-req">*</span></label>
          <select name="department_id" required data-slot="input"
            class="fw-select w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
            <option value="">- Pilih Departemen -</option>
            <% if (typeof departments !== 'undefined') { departments.forEach(dept => { %>
              <option value="<%= dept.id %>" <%= fd.department_id == dept.id ? 'selected' : '' %>><%= dept.name %></option>
            <% }) } %>
          </select>
        </div>

        <div>
          <label class="fw-field-label">Tahun Angkatan <span class="fw-field-req">*</span></label>
          <input type="number" name="year" value="<%= fd.year || '' %>" required data-slot="input"
            placeholder="Misal: 2024" min="2000" max="2099"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

        <div>
          <label class="fw-field-label">Status Mahasiswa <span class="fw-field-req">*</span></label>
          <select name="status" required data-slot="input"
            class="fw-select w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
            <option value="">- Pilih Status -</option>
            <% if (typeof statusMap !== 'undefined') { Object.entries(statusMap).forEach(([key, val]) => { %>
              <option value="<%= key %>" <%= fd.status == key ? 'selected' : '' %>><%= val %></option>
            <% }) } %>
          </select>
        </div>

        <div class="fw-form-full">
          <label class="fw-field-label">Dosen Pembimbing Akademik (PA)</label>
          <select name="advisor_id" data-slot="input"
            class="fw-select w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
            <option value="">- Pilih Dosen PA -</option>
            <% if (typeof advisors !== 'undefined') { advisors.forEach(adv => { %>
              <option value="<%= adv.id %>" <%= fd.advisor_id == adv.id ? 'selected' : '' %>><%= adv.name %></option>
            <% }) } %>
          </select>
        </div>

        <div>
          <label class="fw-field-label">Email</label>
          <input type="email" name="email" value="<%= fd.email || '' %>" data-slot="input"
            placeholder="Email aktif mahasiswa"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

        <div>
          <label class="fw-field-label">No. Telepon / WhatsApp</label>
          <input type="text" name="phone_no" value="<%= fd.phone_no || '' %>" data-slot="input"
            placeholder="08xxxxxxxx" inputmode="numeric"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

      </div>
    </div>
  </div>

  <%# 3. Data Alamat %>
  <div data-slot="card" class="rounded-xl border bg-card shadow-sm">
    <div class="fw-section-hdr">
      <div class="fw-section-icon" style="background:#fff7ed;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="1.75"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </div>
      <span style="font-size:0.875rem;font-weight:600;color:#18181b;">Data Alamat</span>
    </div>
    <div class="fw-section-body">
      <div class="fw-form-grid">

        <div class="fw-form-full">
          <label class="fw-field-label">Alamat Asal</label>
          <textarea name="home_address" rows="3" data-slot="textarea"
            placeholder="Jalan, RT/RW, Kelurahan, Kecamatan"
            class="fw-textarea w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 resize-none transition-[color,box-shadow]"><%= fd.home_address || '' %></textarea>
        </div>

        <div>
          <label class="fw-field-label">Kota / Kab. Asal</label>
          <input type="text" name="home_town" value="<%= fd.home_town || '' %>" data-slot="input"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

        <div>
          <label class="fw-field-label">Provinsi Asal</label>
          <input type="text" name="home_province" value="<%= fd.home_province || '' %>" data-slot="input"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

        <div>
          <label class="fw-field-label">Kode Pos Asal</label>
          <input type="text" name="home_postalcode" value="<%= fd.home_postalcode || '' %>" data-slot="input"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

        <div class="fw-form-full" style="border-top:1px solid #f4f4f5;padding-top:1.125rem;margin-top:0.25rem;">
          <label class="fw-field-label">Alamat Domisili (Saat ini)</label>
          <textarea name="current_address" rows="3" data-slot="textarea"
            placeholder="Alamat tinggal / kos saat ini"
            class="fw-textarea w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 resize-none transition-[color,box-shadow]"><%= fd.current_address || '' %></textarea>
        </div>

        <div>
          <label class="fw-field-label">Kota / Kab. Domisili</label>
          <input type="text" name="current_town" value="<%= fd.current_town || '' %>" data-slot="input"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

        <div>
          <label class="fw-field-label">Provinsi Domisili</label>
          <input type="text" name="current_province" value="<%= fd.current_province || '' %>" data-slot="input"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

        <div>
          <label class="fw-field-label">Kode Pos Domisili</label>
          <input type="text" name="current_postalcode" value="<%= fd.current_postalcode || '' %>" data-slot="input"
            class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        </div>

      </div>
    </div>
  </div>

  <%# Action Buttons %>
  <div style="display:flex;align-items:center;justify-content:flex-end;gap:0.75rem;padding-top:0.25rem;">
    <a href="/mahasiswa/<%= m.id %>" class="btn-outline" style="height:44px;padding:0 1.5rem;font-size:0.9375rem;display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;white-space:nowrap;">
      Batal
    </a>
    <button type="submit" class="btn" style="height:44px;padding:0 1.5rem;font-size:0.9375rem;display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;white-space:nowrap;">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      Simpan Perubahan
    </button>
  </div>

</form>