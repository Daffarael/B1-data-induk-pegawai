<%# views/mahasiswa/show.ejs %>

<style>
  .detail-row { display:flex; justify-content:space-between; gap:1rem; padding:0.75rem 0; border-bottom:1px solid #f4f4f5; }
  .detail-row:last-child { border-bottom:none; }
  .status-badge { display:inline-flex; align-items:center; gap:4px; border-radius:999px; padding:2px 10px; font-size:0.7rem; font-weight:500; border:1px solid; }
</style>

<%# ── Page Header ── %>
<div style="display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.25rem;">
  <div>
    <a href="/mahasiswa" style="display:inline-flex;align-items:center;gap:4px;font-size:0.75rem;color:#a1a1aa;text-decoration:none;margin-bottom:0.375rem;" onmouseover="this.style.color='#18181b'" onmouseout="this.style.color='#a1a1aa'">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      Kembali ke Daftar
    </a>
    <h1 style="font-size:1.25rem;font-weight:600;color:#18181b;margin:0 0 0.375rem;"><%= mahasiswa.name %></h1>
    <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
      <code style="background:#f4f4f5;border-radius:5px;padding:2px 8px;font-size:0.75rem;font-family:monospace;color:#52525b;"><%= mahasiswa.regno %></code>
      <% if (mahasiswa.status === 1) { %>
        <span class="status-badge" style="background:#f0fdf4;color:#16a34a;border-color:#bbf7d0;">● Aktif</span>
      <% } else if (mahasiswa.status === 2) { %>
        <span class="status-badge" style="background:#fffbeb;color:#d97706;border-color:#fde68a;">● Cuti</span>
      <% } else if (mahasiswa.status === 3) { %>
        <span class="status-badge" style="background:#eff6ff;color:#2563eb;border-color:#bfdbfe;">● Lulus</span>
      <% } else if (mahasiswa.status === 4) { %>
        <span class="status-badge" style="background:#f4f4f5;color:#71717a;border-color:#e4e4e7;">● Keluar</span>
      <% } else { %>
        <span class="status-badge" style="background:#fef2f2;color:#dc2626;border-color:#fecaca;">● Drop Out</span>
      <% } %>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:0.5rem;">
    <a href="/mahasiswa/<%= mahasiswa.id %>/edit" class="btn-sm-outline">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Edit
    </a>
    <button type="button" class="btn-sm-destructive"
      data-name="<%= mahasiswa.name %>"
      onclick="fwShowDeleteModal('/mahasiswa/<%= mahasiswa.id %>', this.dataset.name)">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
      Hapus
    </button>
  </div>
</div>

<%# ── Cards Grid ── %>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;align-items:start;">

  <%# Data Pribadi %>
  <div data-slot="card" class="rounded-xl border bg-card text-card-foreground shadow-sm">
    <div style="display:flex;align-items:center;gap:0.625rem;padding:0.875rem 1.25rem;border-bottom:1px solid #f4f4f5;">
      <div style="width:28px;height:28px;border-radius:7px;background:#eef2ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.75"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <h2 style="font-size:0.8125rem;font-weight:600;color:#18181b;margin:0;">Data Pribadi</h2>
    </div>
    <div style="padding:0 1.25rem;">
      <% [
        ['NIM', mahasiswa.regno],
        ['Nama Lengkap', mahasiswa.name],
        ['Tempat Lahir', mahasiswa.birth_place],
        ['Tanggal Lahir', mahasiswa.birth_date ? new Date(mahasiswa.birth_date).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}) : null],
        ['Jenis Kelamin', mahasiswa.gender_text],
        ['Agama', mahasiswa.religion_text],
        ['Kewarganegaraan', mahasiswa.citizenship]
      ].forEach(([label, val]) => { %>
        <div class="detail-row">
          <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:140px;"><%= label %></span>
          <span style="font-size:0.75rem;color:#18181b;text-align:right;"><%= val || '—' %></span>
        </div>
      <% }) %>
    </div>
  </div>

  <div style="display:flex;flex-direction:column;gap:1rem;">

    <%# Data Akademik %>
    <div data-slot="card" class="rounded-xl border bg-card text-card-foreground shadow-sm">
      <div style="display:flex;align-items:center;gap:0.625rem;padding:0.875rem 1.25rem;border-bottom:1px solid #f4f4f5;">
        <div style="width:28px;height:28px;border-radius:7px;background:#f0fdf4;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="1.75"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        </div>
        <h2 style="font-size:0.8125rem;font-weight:600;color:#18181b;margin:0;">Data Akademik</h2>
      </div>
      <div style="padding:0 1.25rem;">
        <% [
          ['Departemen', mahasiswa.department_name],
          ['Tahun Angkatan', mahasiswa.year],
          ['Status', mahasiswa.status_text],
          ['Dosen PA', mahasiswa.advisor_name]
        ].forEach(([label, val]) => { %>
          <div class="detail-row">
            <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:140px;"><%= label %></span>
            <span style="font-size:0.75rem;color:#18181b;text-align:right;"><%= val || '—' %></span>
          </div>
        <% }) %>
      </div>
    </div>

    <%# Kontak & Alamat %>
    <div data-slot="card" class="rounded-xl border bg-card text-card-foreground shadow-sm">
      <div style="display:flex;align-items:center;gap:0.625rem;padding:0.875rem 1.25rem;border-bottom:1px solid #f4f4f5;">
        <div style="width:28px;height:28px;border-radius:7px;background:#fff7ed;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="1.75"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.6 19.79 19.79 0 0 1 1.6 5.07 2 2 0 0 1 3.57 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.6a16 16 0 0 0 6 6l1.22-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <h2 style="font-size:0.8125rem;font-weight:600;color:#18181b;margin:0;">Kontak & Alamat</h2>
      </div>
      <div style="padding:0 1.25rem;">
        <% [
          ['Email', mahasiswa.email],
          ['No. Telepon/WA', mahasiswa.phone_no],
          ['Alamat Asal', mahasiswa.home_address],
          ['Kota/Kab. Asal', mahasiswa.home_town],
          ['Provinsi Asal', mahasiswa.home_province],
          ['Kode Pos Asal', mahasiswa.home_postalcode],
          ['Alamat Domisili', mahasiswa.current_address],
          ['Kota/Kab. Domisili', mahasiswa.current_town],
          ['Provinsi Domisili', mahasiswa.current_province],
          ['Kode Pos Domisili', mahasiswa.current_postalcode]
        ].forEach(([label, val]) => { %>
          <div class="detail-row">
            <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:140px;"><%= label %></span>
            <span style="font-size:0.75rem;color:#18181b;text-align:right;white-space:pre-wrap;"><%= val || '—' %></span>
          </div>
        <% }) %>
      </div>
    </div>

  </div>
</div>