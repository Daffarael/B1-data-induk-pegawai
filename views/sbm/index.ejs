<%# views/sbm/index.ejs %>

<style>
  .pg-stats   { display:grid; grid-template-columns:repeat(3,1fr); gap:0.75rem; margin-bottom:1.125rem; }
  .pg-stat    { background:#fff; border:1px solid #e4e4e7; border-radius:12px; padding:1rem 1.125rem; }
  .pg-icon    { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .pg-table th{ height:36px; padding:0 1rem; text-align:left; font-size:0.65rem; font-weight:600; color:#a1a1aa; text-transform:uppercase; letter-spacing:0.06em; white-space:nowrap; }
  .pg-table th.center { text-align:center; }
  .pg-table th.right  { text-align:right; }
  .pg-table td{ padding:0.75rem 1rem; font-size:0.8125rem; vertical-align:middle; }
  .pg-table tr{ border-bottom:1px solid #f4f4f5; transition:background 0.1s; }
  .pg-table tr:last-child{ border-bottom:none; }
  .pg-table tr:hover{ background:#fafafa; }
  .action-btn    { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:7px; color:#a1a1aa; transition:all 0.1s; border:none; background:transparent; cursor:pointer; }
  .action-btn:hover      { background:#f4f4f5; color:#18181b; }
  .action-btn.edit:hover { background:#fffbeb; color:#d97706; }
  .action-btn.del:hover  { background:#fef2f2; color:#dc2626; }
  .pg-num        { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:7px; border:1px solid #e4e4e7; font-size:0.75rem; color:#52525b; text-decoration:none; background:#fff; transition:all 0.1s; }
  .pg-num:hover  { background:#f4f4f5; }
  .pg-num.active { background:#18181b; border-color:#18181b; color:#fff; font-weight:600; }
  @media(max-width:900px){ .pg-stats{ grid-template-columns:repeat(2,1fr); } }
</style>

<%# ── Stat Cards ── %>
<div class="pg-stats">

  <div class="pg-stat">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
      <span style="font-size:0.65rem;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;">Total Tarif</span>
      <div class="pg-icon" style="background:#f4f4f5;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#71717a" stroke-width="1.75"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      </div>
    </div>
    <div style="font-size:1.625rem;font-weight:700;color:#18181b;letter-spacing:-0.03em;line-height:1;"><%= totalSbm %></div>
    <div style="font-size:0.7rem;color:#a1a1aa;margin-top:0.25rem;">tarif terdaftar</div>
  </div>

  <div class="pg-stat">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
      <span style="font-size:0.65rem;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;">Komponen</span>
      <div class="pg-icon" style="background:#eef2ff;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.75"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      </div>
    </div>
    <div style="font-size:1.625rem;font-weight:700;color:#18181b;letter-spacing:-0.03em;line-height:1;"><%= totalKomponen %></div>
    <div style="font-size:0.7rem;color:#a1a1aa;margin-top:0.25rem;">jenis komponen</div>
  </div>

  <div class="pg-stat">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
      <span style="font-size:0.65rem;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;">Kota</span>
      <div class="pg-icon" style="background:#f0fdf4;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="1.75"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </div>
    </div>
    <div style="font-size:1.625rem;font-weight:700;color:#18181b;letter-spacing:-0.03em;line-height:1;"><%= totalKota %></div>
    <div style="font-size:0.7rem;color:#a1a1aa;margin-top:0.25rem;">kota tujuan</div>
  </div>

</div>

<%# ── Main Card ── %>
<div style="background:#fff;border:1px solid #e4e4e7;border-radius:12px;overflow:hidden;">

  <%# ── Header bar ── %>
  <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.625rem;padding:0.875rem 1rem;border-bottom:1px solid #f4f4f5;">

    <form method="GET" action="/sbm" style="display:flex;align-items:center;gap:0.5rem;flex:1;min-width:0;">
      <div style="position:relative;">
        <svg style="position:absolute;left:8px;top:50%;transform:translateY(-50%);color:#a1a1aa;pointer-events:none;" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" name="search" value="<%= search %>" placeholder="Cari kota, komponen, kode..."
          data-slot="input"
          style="height:32px;padding:0 10px 0 28px;width:220px;font-size:0.8125rem;border:1px solid #e4e4e7;border-radius:8px;outline:none;background:#fff;color:#18181b;"
          onfocus="this.style.borderColor='#a1a1aa'" onblur="this.style.borderColor='#e4e4e7'">
      </div>
      <button type="submit" class="btn-sm" style="height:32px;padding:0 14px;font-size:0.75rem;">Cari</button>
      <% if (search) { %>
        <a href="/sbm" class="btn-sm-outline" style="height:32px;padding:0 12px;font-size:0.75rem;">Reset</a>
      <% } %>
    </form>

    <div style="display:flex;align-items:center;gap:0.5rem;flex-shrink:0;">
      <a href="/sbm/export/pdf/preview?search=<%= encodeURIComponent(search) %>"
        class="btn-sm-outline" style="height:32px;padding:0 12px;font-size:0.75rem;display:inline-flex;align-items:center;gap:5px;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Ekspor PDF
      </a>
      <a href="/sbm/export/json/preview?search=<%= encodeURIComponent(search) %>"
        class="btn-sm-outline" style="height:32px;padding:0 12px;font-size:0.75rem;display:inline-flex;align-items:center;gap:5px;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        Ekspor JSON
      </a>
      <a href="/sbm/create" class="btn-sm" style="height:32px;padding:0 14px;font-size:0.75rem;display:inline-flex;align-items:center;gap:5px;">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tambah
      </a>
    </div>
  </div>

  <% if (sbm.length === 0) { %>
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:4rem 1rem;text-align:center;">
      <div style="width:44px;height:44px;border-radius:10px;background:#f4f4f5;display:flex;align-items:center;justify-content:center;margin-bottom:0.875rem;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      </div>
      <p style="font-size:0.875rem;font-weight:600;color:#18181b;margin:0 0 0.25rem;">Belum ada data SBM Perjalanan Dinas</p>
      <p style="font-size:0.75rem;color:#a1a1aa;margin:0 0 1.25rem;">Klik "Tambah" untuk menambahkan tarif baru</p>
      <a href="/sbm/create" class="btn-sm" style="height:32px;padding:0 16px;font-size:0.75rem;display:inline-flex;align-items:center;gap:5px;">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tambah SBM
      </a>
    </div>

  <% } else { %>
    <div style="overflow-x:auto;">
      <table class="pg-table" style="width:100%;border-collapse:collapse;">
        <thead style="background:#fafafa;border-bottom:1px solid #f4f4f5;">
          <tr>
            <th class="center" style="width:36px;">#</th>
            <th>Kota Tujuan</th>
            <th>Komponen Biaya</th>
            <th class="center">Kode</th>
            <th>Peruntukan</th>
            <th class="right">Tarif (Rp)</th>
            <th class="center" style="width:96px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% sbm.forEach((s, i) => { %>
            <tr>
              <td style="text-align:center;color:#a1a1aa;font-size:0.7rem;"><%= (currentPage-1)*10+i+1 %></td>
              <td>
                <div style="font-size:0.8125rem;font-weight:500;color:#18181b;"><%= s.kota %></div>
              </td>
              <td style="color:#71717a;font-size:0.775rem;"><%= s.komponen %></td>
              <td style="text-align:center;">
                <code style="background:#f4f4f5;border-radius:5px;padding:2px 6px;font-size:0.7rem;font-family:monospace;"><%= s.kode_komponen %></code>
              </td>
              <td>
                <% if (s.jabatan) { %>
                  <span style="display:inline-flex;align-items:center;border-radius:999px;padding:2px 8px;font-size:0.7rem;font-weight:500;background:#f4f4f5;color:#52525b;border:1px solid #e4e4e7;"><%= s.jabatan %></span>
                <% } else if (s.golongan) { %>
                  <span style="display:inline-flex;align-items:center;border-radius:999px;padding:2px 8px;font-size:0.7rem;font-weight:500;background:#f4f4f5;color:#52525b;border:1px solid #e4e4e7;"><%= s.golongan %></span>
                <% } else { %>
                  <span style="font-size:0.75rem;color:#a1a1aa;font-style:italic;">Semua</span>
                <% } %>
              </td>
              <td style="text-align:right;font-size:0.8125rem;font-weight:600;color:#18181b;">Rp <%= Number(s.amount).toLocaleString('id-ID') %></td>
              <td>
                <div style="display:flex;align-items:center;justify-content:center;gap:2px;">
                  <a href="/sbm/<%= s.id %>" class="action-btn" title="Detail">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  </a>
                  <a href="/sbm/<%= s.id %>/edit" class="action-btn edit" title="Edit">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                  <button type="button" class="action-btn del" title="Hapus"
                    data-name="<%= s.kota %> – <%= s.komponen %>"
                    onclick="fwShowDeleteModal('/sbm/<%= s.id %>', this.dataset.name)">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <%# Pagination footer %>
    <% if (totalPages > 1) { %>
    <div style="display:flex;align-items:center;justify-content:center;padding:0.625rem 1rem;border-top:1px solid #f4f4f5;">
      <div style="display:flex;align-items:center;gap:4px;">
        <% if (currentPage > 1) { %>
          <a href="/sbm?page=<%=currentPage-1%>&search=<%=encodeURIComponent(search)%>" class="pg-num">‹</a>
        <% } %>
        <% for(let pg=Math.max(1,currentPage-2); pg<=Math.min(totalPages,currentPage+2); pg++) { %>
          <a href="/sbm?page=<%=pg%>&search=<%=encodeURIComponent(search)%>" class="pg-num<%=pg===currentPage?' active':''%>"><%=pg%></a>
        <% } %>
        <% if (currentPage < totalPages) { %>
          <a href="/sbm?page=<%=currentPage+1%>&search=<%=encodeURIComponent(search)%>" class="pg-num">›</a>
        <% } %>
      </div>
    </div>
    <% } %>
  <% } %>

</div>