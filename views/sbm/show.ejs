<%# views/sbm/show.ejs %>

<div class="fw-page-header">
  <div>
    <a href="/sbm" style="font-size:0.8rem; color:#94a3b8; text-decoration:none; display:inline-flex; align-items:center; gap:0.3rem; margin-bottom:0.5rem;" onmouseover="this.style.color='#c8ccda'" onmouseout="this.style.color='#94a3b8'">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      Data SBM Perjadin
    </a>
    <h1 class="fw-page-title">Detail SBM — <%= sbm.kota %></h1>
    <p class="fw-page-subtitle">Detail tarif Standar Biaya Masukan Perjalanan Dinas</p>
  </div>
  <div style="display:flex; gap:0.5rem;">
    <a href="/sbm/<%= sbm.id %>/edit" class="fw-btn fw-btn-outline fw-btn-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Edit
    </a>
    <form method="POST" action="/sbm/<%= sbm.id %>" onsubmit="return confirm('Hapus data ini?')" style="display:inline;">
      <input type="hidden" name="_method" value="DELETE">
      <button type="submit" class="fw-btn fw-btn-sm" style="background:#ef4444; color:#fff; border-color:#ef4444;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
        Hapus
      </button>
    </form>
  </div>
</div>

<div class="fw-card">
  <div class="fw-form-section-title">✈️ Informasi Tarif SBM</div>
  <div class="fw-detail-grid">

    <div class="fw-detail-item">
      <div class="fw-detail-label">Kota Tujuan</div>
      <div class="fw-detail-value"><strong><%= sbm.kota %></strong></div>
    </div>

    <div class="fw-detail-item">
      <div class="fw-detail-label">Komponen Biaya</div>
      <div class="fw-detail-value">
        <%= sbm.komponen %>&nbsp;<span class="fw-mono-chip"><%= sbm.kode_komponen %></span>
      </div>
    </div>

    <div class="fw-detail-item fw-col-2">
      <div class="fw-detail-label">Deskripsi Komponen</div>
      <div class="fw-detail-value"><%= sbm.komponen_desc || '-' %></div>
    </div>

    <div class="fw-detail-item">
      <div class="fw-detail-label">Jabatan Struktural</div>
      <div class="fw-detail-value">
        <% if (sbm.jabatan) { %>
          <span class="fw-badge fw-badge-dark"><%= sbm.jabatan %></span>
        <% } else { %>
          <span style="color:#475569; font-style:italic;">Semua Jabatan</span>
        <% } %>
      </div>
    </div>

    <div class="fw-detail-item">
      <div class="fw-detail-label">Golongan Pegawai</div>
      <div class="fw-detail-value">
        <% if (sbm.golongan) { %>
          <span class="fw-badge fw-badge-gray"><%= sbm.golongan %></span>
        <% } else { %>
          <span style="color:#475569; font-style:italic;">Semua Golongan</span>
        <% } %>
      </div>
    </div>

    <div class="fw-detail-item fw-col-2">
      <div class="fw-detail-label">Jumlah Tarif</div>
      <div class="fw-detail-value" style="font-size:1.4rem; font-weight:700; color:#a5b4fc; font-family:monospace;">
        Rp <%= Number(sbm.amount).toLocaleString('id-ID') %>
      </div>
    </div>

  </div>
</div>