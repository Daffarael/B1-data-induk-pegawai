<%# views/sbm/show.ejs %>

<style>
  .action-btn    { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:7px; color:#a1a1aa; transition:all 0.1s; border:none; background:transparent; cursor:pointer; }
  .action-btn:hover      { background:#f4f4f5; color:#18181b; }
  .action-btn.edit:hover { background:#fffbeb; color:#d97706; }
  .action-btn.del:hover  { background:#fef2f2; color:#dc2626; }
</style>

<%# ── Page Header ── %>
<div style="display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.25rem;">
  <div>
    <a href="/sbm" style="display:inline-flex;align-items:center;gap:4px;font-size:0.75rem;color:#a1a1aa;text-decoration:none;margin-bottom:0.375rem;" onmouseover="this.style.color='#18181b'" onmouseout="this.style.color='#a1a1aa'">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      Kembali ke Daftar
    </a>
    <h1 style="font-size:1.25rem;font-weight:600;color:#18181b;margin:0 0 0.375rem;"><%= sbm.kota %></h1>
    <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
      <code style="background:#f4f4f5;border-radius:5px;padding:2px 8px;font-size:0.75rem;font-family:monospace;color:#52525b;"><%= sbm.kode_komponen %></code>
      <span style="display:inline-flex;align-items:center;border-radius:999px;padding:2px 10px;font-size:0.7rem;font-weight:500;background:#f4f4f5;color:#52525b;border:1px solid #e4e4e7;"><%= sbm.komponen %></span>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:0.5rem;">
    <a href="/sbm/<%= sbm.id %>/edit" class="btn-sm-outline">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Edit
    </a>
    <button type="button" class="btn-sm-destructive"
      data-name="<%= sbm.kota %> – <%= sbm.komponen %>"
      onclick="fwShowDeleteModal('/sbm/<%= sbm.id %>', this.dataset.name)">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
      Hapus
    </button>
  </div>
</div>

<%# ── Detail Card ── %>
<div data-slot="card" class="rounded-xl border bg-card text-card-foreground shadow-sm">
  <div style="display:flex;align-items:center;gap:0.625rem;padding:0.875rem 1.25rem;border-bottom:1px solid #f4f4f5;">
    <div style="width:28px;height:28px;border-radius:7px;background:#eef2ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.75"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
    </div>
    <h2 style="font-size:0.8125rem;font-weight:600;color:#18181b;margin:0;">Informasi Tarif SBM</h2>
  </div>
  <div style="padding:0 1.25rem;">

    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;border-bottom:1px solid #f4f4f5;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Kota Tujuan</span>
      <span style="font-size:0.75rem;font-weight:500;color:#18181b;text-align:right;"><%= sbm.kota %></span>
    </div>

    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;border-bottom:1px solid #f4f4f5;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Komponen Biaya</span>
      <span style="font-size:0.75rem;color:#18181b;text-align:right;"><%= sbm.komponen %></span>
    </div>

    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;border-bottom:1px solid #f4f4f5;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Kode Komponen</span>
      <span style="font-size:0.75rem;color:#18181b;text-align:right;">
        <code style="background:#f4f4f5;border-radius:4px;padding:1px 6px;font-family:monospace;font-size:0.7rem;"><%= sbm.kode_komponen %></code>
      </span>
    </div>

    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;border-bottom:1px solid #f4f4f5;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Peruntukan Jabatan</span>
      <span style="font-size:0.75rem;color:#18181b;text-align:right;"><%= sbm.jabatan || '—' %></span>
    </div>

    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;border-bottom:1px solid #f4f4f5;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Peruntukan Golongan</span>
      <span style="font-size:0.75rem;color:#18181b;text-align:right;"><%= sbm.golongan || '—' %></span>
    </div>

    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;border-bottom:1px solid #f4f4f5;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Jumlah Tarif</span>
      <span style="font-size:0.9375rem;font-weight:700;color:#18181b;text-align:right;">Rp <%= Number(sbm.amount).toLocaleString('id-ID') %></span>
    </div>

    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;border-bottom:1px solid #f4f4f5;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Dibuat</span>
      <span style="font-size:0.75rem;color:#18181b;text-align:right;">
        <%= sbm.created_at ? new Date(sbm.created_at).toLocaleDateString('id-ID',{dateStyle:'long'}) : '—' %>
      </span>
    </div>

    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Terakhir diperbarui</span>
      <span style="font-size:0.75rem;color:#18181b;text-align:right;">
        <%= sbm.updated_at ? new Date(sbm.updated_at).toLocaleDateString('id-ID',{dateStyle:'long'}) : '—' %>
      </span>
    </div>

  </div>
</div>