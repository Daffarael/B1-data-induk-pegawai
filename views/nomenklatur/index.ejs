<%# views/nomenklatur/index.ejs %>

<style>
  .pg-stats   { display:grid; grid-template-columns:repeat(2,1fr); gap:0.75rem; margin-bottom:1.125rem; }
  .pg-stat    { background:#fff; border:1px solid #e4e4e7; border-radius:12px; padding:1rem 1.125rem; }
  .pg-icon    { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .pg-table th{ height:36px; padding:0 1rem; text-align:left; font-size:0.65rem; font-weight:600; color:#a1a1aa; text-transform:uppercase; letter-spacing:0.06em; white-space:nowrap; }
  .pg-table th.center { text-align:center; }
  .pg-table td{ padding:0.75rem 1rem; font-size:0.8125rem; vertical-align:middle; }
  .pg-table tr{ border-bottom:1px solid #f4f4f5; transition:background 0.1s; }
  .pg-table tr:last-child{ border-bottom:none; }
  .pg-table tr:hover{ background:#fafafa; }
  .action-btn    { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:7px; color:#a1a1aa; transition:all 0.1s; border:none; background:transparent; cursor:pointer; }
  .action-btn:hover      { background:#f4f4f5; color:#18181b; }
  .action-btn.edit:hover { background:#fffbeb; color:#d97706; }
  .action-btn.del:hover  { background:#fef2f2; color:#dc2626; }
  .pg-num        { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:7px; border:1px solid #e4e4e7; font-size:0.75rem; color:#52525b; text-decoration:none; background:#fff; transition:all 0.1s; }
  .pg-num:hover  { background:#f4f4f5; }
  .pg-num.active { background:#18181b; border-color:#18181b; color:#fff; font-weight:600; }
  @media(max-width:900px){ .pg-stats{ grid-template-columns:repeat(1,1fr); } }
</style>

<%# ── Stat Cards ──────────────────────────────────────── %>
<div class="pg-stats">

  <div class="pg-stat">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
      <span style="font-size:0.65rem;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;">Total Nomenklatur</span>
      <div class="pg-icon" style="background:#eef2ff;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.75"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
      </div>
    </div>
    <div style="font-size:1.625rem;font-weight:700;color:#18181b;letter-spacing:-0.03em;line-height:1;"><%= totalNomenklatur %></div>
    <div style="font-size:0.7rem;color:#a1a1aa;margin-top:0.25rem;">nomenklatur terdaftar</div>
  </div>

  <div class="pg-stat">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
      <span style="font-size:0.65rem;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;">Total Klasifikasi</span>
      <div class="pg-icon" style="background:#f0fdf4;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="1.75"><path d="M3 3h6v6H3z"/><path d="M15 3h6v6h-6z"/><path d="M3 15h6v6H3z"/><path d="M15 15h6v6h-6z"/></svg>
      </div>
    </div>
    <div style="font-size:1.625rem;font-weight:700;color:#18181b;letter-spacing:-0.03em;line-height:1;"><%= totalKlasifikasi %></div>
    <div style="font-size:0.7rem;color:#a1a1aa;margin-top:0.25rem;">dari semua nomenklatur</div>
  </div>



</div>

<%# ── Main Card ──────────────────────────────────────────── %>
<div data-slot="card" class="rounded-xl border bg-card text-card-foreground shadow-sm">

  <%# Toolbar %>
  <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.5rem;padding:0.75rem 1rem;border-bottom:1px solid #f4f4f5;">
    <form method="GET" action="/nomenklatur" style="display:flex;flex-wrap:wrap;align-items:center;gap:0.5rem;flex:1;min-width:0;">
      <div style="position:relative;">
        <svg style="position:absolute;left:9px;top:50%;transform:translateY(-50%);color:#a1a1aa;" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" name="search" value="<%= search %>" placeholder="Cari nama atau golongan…"
          data-slot="input"
          style="height:32px;padding-left:30px;padding-right:12px;width:200px;"
          class="rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
      </div>
      <button type="submit" class="btn-sm" style="height:32px;padding:0 12px;font-size:0.75rem;">Cari</button>
      <a href="/nomenklatur" class="btn-sm-outline" style="height:32px;padding:0 12px;font-size:0.75rem;">Reset</a>
    </form>
    <div style="display:flex;align-items:center;gap:0.375rem;margin-left:auto;">
      <a href="/nomenklatur/export/pdf/preview?search=<%=encodeURIComponent(search)%>"
        class="btn-sm-outline" style="height:32px;padding:0 12px;font-size:0.75rem;display:inline-flex;align-items:center;gap:5px;">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Export PDF
      </a>
      <a href="/nomenklatur/export/json/preview?search=<%=encodeURIComponent(search)%>"
        class="btn-sm-outline" style="height:32px;padding:0 12px;font-size:0.75rem;display:inline-flex;align-items:center;gap:5px;">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        Export JSON
      </a>
      <a href="/nomenklatur/create"
        class="btn-sm" style="height:32px;padding:0 12px;font-size:0.75rem;display:inline-flex;align-items:center;gap:5px;">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tambah
      </a>
    </div>
  </div>

  <%# Import CSV %>
  <div style="padding:0.375rem 1rem;border-bottom:1px solid #f4f4f5;background:#fafafa;">
    <details>
      <summary style="font-size:0.7rem;color:#a1a1aa;cursor:pointer;display:flex;align-items:center;gap:6px;padding:4px 0;list-style:none;user-select:none;" class="hover:text-foreground transition-colors">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        Import dari CSV
      </summary>
      <div style="padding:0.625rem 0 0.375rem;">
        <form method="POST" action="/nomenklatur/import" enctype="multipart/form-data">
          <div style="display:flex;align-items:center;gap:0.625rem;flex-wrap:wrap;">
            <input type="file" name="csv_file" accept=".csv" id="csvNomFileInput"
              style="position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;clip:rect(0,0,0,0);">
            <label for="csvNomFileInput" class="btn-sm-outline"
              style="height:32px;padding:0 0.875rem;font-size:0.75rem;display:inline-flex;align-items:center;gap:6px;cursor:pointer;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              Pilih File CSV
            </label>
            <span id="csvNomFileName"
              style="font-size:0.7rem;color:#71717a;padding:0 0.625rem;height:32px;display:inline-flex;align-items:center;gap:5px;border:1px solid #e4e4e7;border-radius:6px;background:#fafafa;min-width:140px;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span id="csvNomFileNameText" style="color:#a1a1aa;font-style:italic;">Belum ada file dipilih</span>
            </span>
            <button type="submit"
              style="height:32px;padding:0 0.875rem;font-size:0.75rem;background:#059669;color:#fff;border:none;border-radius:6px;display:inline-flex;align-items:center;gap:5px;font-weight:500;cursor:pointer;transition:background 0.12s;"
              onmouseover="this.style.background='#047857'" onmouseout="this.style.background='#059669'">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Upload & Import
            </button>
          </div>
          <p style="font-size:0.65rem;color:#a1a1aa;margin-top:8px;">
            Kolom: <code style="background:#f4f4f5;padding:1px 5px;border-radius:4px;font-size:0.65rem;">name, qualification, duties, grade</code>
          </p>
        </form>
        <script>
          document.getElementById('csvNomFileInput').addEventListener('change', function() {
            const nameEl = document.getElementById('csvNomFileNameText');
            if (this.files && this.files[0]) {
              nameEl.textContent = this.files[0].name;
              nameEl.style.color = '#18181b';
              nameEl.style.fontStyle = 'normal';
            } else {
              nameEl.textContent = 'Belum ada file dipilih';
              nameEl.style.color = '#a1a1aa';
              nameEl.style.fontStyle = 'italic';
            }
          });
        </script>
      </div>
    </details>
  </div>

  <%# Empty State %>
  <% if (nomenklatur.length === 0) { %>
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:4rem 1.5rem;text-align:center;">
      <div style="width:48px;height:48px;border-radius:12px;background:#f4f4f5;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
      </div>
      <p style="font-size:0.875rem;font-weight:600;color:#18181b;margin:0 0 0.25rem;">Belum ada data nomenklatur</p>
      <p style="font-size:0.75rem;color:#a1a1aa;margin:0 0 1.25rem;">Klik "Tambah" untuk menambahkan data baru</p>
      <a href="/nomenklatur/create" class="btn-sm" style="height:32px;padding:0 16px;font-size:0.75rem;display:inline-flex;align-items:center;gap:5px;">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tambah Nomenklatur
      </a>
    </div>

  <% } else { %>
    <div style="overflow-x:auto;">
      <table class="pg-table" style="width:100%;border-collapse:collapse;">
        <thead style="background:#fafafa;border-bottom:1px solid #f4f4f5;">
          <tr>
            <th class="center" style="width:36px;">#</th>
            <th>Nama Nomenklatur</th>
            <th>Golongan</th>
            <th class="center">Jml Klasifikasi</th>
            <th class="center" style="width:96px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% nomenklatur.forEach((n, i) => { %>
            <tr>
              <td style="text-align:center;color:#a1a1aa;font-size:0.7rem;"><%= (currentPage-1)*10+i+1 %></td>
              <td>
                <div style="font-size:0.8125rem;font-weight:500;color:#18181b;"><%= n.name %></div>
                <% if (n.qualification) { %>
                  <div style="font-size:0.7rem;color:#a1a1aa;margin-top:1px;max-width:320px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= n.qualification %></div>
                <% } %>
              </td>
              <td><code style="background:#f4f4f5;border-radius:5px;padding:2px 6px;font-size:0.7rem;font-family:monospace;"><%= n.grade %></code></td>
              <td style="text-align:center;">
                <span class="badge-secondary" style="display:inline-flex;align-items:center;border-radius:999px;padding:2px 8px;font-size:0.7rem;font-weight:500;background:#f4f4f5;color:#52525b;border:1px solid #e4e4e7;"><%= n.jumlah_klasifikasi %> klasifikasi</span>
              </td>
              <td>
                <div style="display:flex;align-items:center;justify-content:center;gap:2px;">
                  <a href="/nomenklatur/<%= n.id %>" class="action-btn" title="Detail">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  </a>
                  <a href="/nomenklatur/<%= n.id %>/edit" class="action-btn edit" title="Edit">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                  <button type="button" class="action-btn del" title="Hapus"
                    data-name="<%= n.name %>"
                    onclick="fwShowDeleteModal('/nomenklatur/<%= n.id %>', this.dataset.name)">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <%# Pagination footer %>
    <% if (totalPages > 1) { %>
    <div style="display:flex;align-items:center;justify-content:center;padding:0.625rem 1rem;border-top:1px solid #f4f4f5;">
      <div style="display:flex;align-items:center;gap:4px;">
        <% if (currentPage > 1) { %>
          <a href="/nomenklatur?page=<%=currentPage-1%>&search=<%=encodeURIComponent(search)%>" class="pg-num">‹</a>
        <% } %>
        <% for(let pg=Math.max(1,currentPage-2); pg<=Math.min(totalPages,currentPage+2); pg++) { %>
          <a href="/nomenklatur?page=<%=pg%>&search=<%=encodeURIComponent(search)%>" class="pg-num<%=pg===currentPage?' active':''%>"><%=pg%></a>
        <% } %>
        <% if (currentPage < totalPages) { %>
          <a href="/nomenklatur?page=<%=currentPage+1%>&search=<%=encodeURIComponent(search)%>" class="pg-num">›</a>
        <% } %>
      </div>
    </div>

    <% } %>
  <% } %>

</div>