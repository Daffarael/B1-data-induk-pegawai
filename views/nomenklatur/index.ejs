<%# views/nomenklatur/index.ejs %>

  <%# ── Stat cards ────────────────────────────────────────────── %>
    <div class="fw-stats-grid">
      <div class="fw-stat">
        <div class="fw-stat-label">Total Nomenklatur</div>
        <div class="fw-stat-value">
          <%= totalNomenklatur %>
        </div>
        <div class="fw-stat-sub">terdaftar</div>
      </div>
      <div class="fw-stat">
        <div class="fw-stat-label">Total Klasifikasi</div>
        <div class="fw-stat-value">
          <%= totalKlasifikasi %>
        </div>
        <div class="fw-stat-sub">dari semua nomenklatur</div>
      </div>
      <div class="fw-stat">
        <div class="fw-stat-label">Hasil Pencarian</div>
        <div class="fw-stat-value">
          <%= total %>
        </div>
        <div class="fw-stat-sub">data ditemukan</div>
      </div>
    </div>

    <%# ── Main card ─────────────────────────────────────────────── %>
      <div class="fw-card">

        <%# Toolbar %>
          <div class="fw-toolbar">
            <form method="GET" action="/nomenklatur" class="fw-toolbar-form">
              <div class="fw-toolbar-field fw-toolbar-search">
                <div class="fw-input-icon-wrap">
                  <svg class="fw-input-icon" width="14" height="14" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.35-4.35" />
                  </svg>
                  <input type="text" name="search" value="<%= search %>" placeholder="Cari nama atau golongan..."
                    class="fw-input fw-input-with-icon">
                </div>
              </div>
              <div class="fw-toolbar-actions">
                <button type="submit" class="fw-btn fw-btn-primary fw-btn-sm">Cari</button>
                <a href="/nomenklatur" class="fw-btn fw-btn-ghost fw-btn-sm">Reset</a>
              </div>
            </form>

            <div class="fw-toolbar-right">
              <a href="/nomenklatur/export/pdf?search=<%= encodeURIComponent(search) %>"
                class="fw-btn fw-btn-outline fw-btn-sm" target="_blank">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="16" y1="13" x2="8" y2="13" />
                  <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
                Export PDF
              </a>
              <a href="/nomenklatur/export/json?search=<%= encodeURIComponent(search) %>"
                class="fw-btn fw-btn-outline fw-btn-sm">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                </svg>
                Export JSON
              </a>
              <a href="/nomenklatur/create" class="fw-btn fw-btn-primary fw-btn-sm">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="12" y1="5" x2="12" y2="19" />
                  <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Tambah
              </a>
            </div>

          </div>

          <%# Import CSV %>
            <div class="fw-import-row">
              <details>
                <summary class="fw-import-toggle">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="17 8 12 3 7 8" />
                    <line x1="12" y1="3" x2="12" y2="15" />
                  </svg>
                  Import dari CSV
                </summary>
                <div class="fw-import-body">
                  <form method="POST" action="/nomenklatur/import" enctype="multipart/form-data" class="fw-import-form">
                    <input type="file" name="csv_file" accept=".csv" class="fw-import-file">
                    <button type="submit" class="fw-btn fw-btn-sm"
                      style="background:#10b981; color:#fff; border-color:#10b981;">
                      Upload & Import
                    </button>
                  </form>
                  <p class="fw-import-hint">
                    Kolom wajib CSV: <code>name, qualification, duties, grade</code>
                  </p>
                </div>
              </details>
            </div>

            <div class="fw-divider"></div>

            <% if (nomenklatur.length===0) { %>
              <div class="fw-empty">
                <svg class="fw-empty-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.2">
                  <rect x="2" y="7" width="20" height="14" rx="2" />
                  <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" />
                  <line x1="12" y1="12" x2="12" y2="16" />
                  <line x1="10" y1="14" x2="14" y2="14" />
                </svg>
                <div class="fw-empty-title">Belum ada data nomenklatur</div>
                <div class="fw-empty-desc">Klik "Tambah" untuk menambahkan data baru</div>
                <a href="/nomenklatur/create" class="fw-btn fw-btn-primary fw-btn-sm" style="margin-top:1rem;">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                  Tambah Nomenklatur
                </a>
              </div>

              <% } else { %>
                <div class="fw-table-wrap">
                  <table class="fw-table">
                    <thead>
                      <tr>
                        <th style="width:36px; text-align:center;">#</th>
                        <th>Nama Nomenklatur</th>
                        <th>Golongan</th>
                        <th style="text-align:center;">Jml Klasifikasi</th>
                        <th style="width:96px; text-align:center;">Aksi</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% nomenklatur.forEach((n, i)=> { %>
                        <tr>
                          <td style="text-align:center; color:#c8ccda; font-size:0.75rem;">
                            <%= (currentPage - 1) * 10 + i + 1 %>
                          </td>
                          <td>
                            <div class="fw-cell-name">
                              <%= n.name %>
                            </div>
                          </td>
                          <td>
                            <span class="fw-mono-chip">
                              <%= n.grade %>
                            </span>
                          </td>
                          <td style="text-align:center;">
                            <span class="fw-badge fw-badge-dark">
                              <%= n.jumlah_klasifikasi %> klasifikasi
                            </span>
                          </td>
                          <td>
                            <div class="fw-action-btns">
                              <a href="/nomenklatur/<%= n.id %>" class="fw-action-btn" title="Detail">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                  stroke-width="2">
                                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                  <circle cx="12" cy="12" r="3" />
                                </svg>
                              </a>
                              <a href="/nomenklatur/<%= n.id %>/edit" class="fw-action-btn fw-action-warn" title="Edit">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                  stroke-width="2">
                                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                </svg>
                              </a>
                              <button type="button" class="fw-action-btn fw-action-danger" title="Hapus"
                                data-id="<%= n.id %>" data-name="<%= n.name %>"
                                onclick="fwShowDeleteModal('/nomenklatur/' + this.dataset.id, this.dataset.name)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                              </button>
                            </div>
                          </td>
                        </tr>
                        <% }) %>
                    </tbody>
                  </table>
                </div>

                <div class="fw-table-footer">
                  <span class="fw-table-info">
                    Menampilkan <%= (currentPage - 1) * 10 + 1 %>–<%= Math.min(currentPage * 10, total) %> dari <strong>
                          <%= total %>
                        </strong> data
                  </span>
                  <% if (totalPages> 1) { %>
                    <div class="fw-pagination">
                      <% if (currentPage> 1) { %>
                        <a href="/nomenklatur?page=<%= currentPage-1 %>&search=<%= encodeURIComponent(search) %>"
                          class="fw-page-btn">‹</a>
                        <% } %>
                          <% for(let pg=Math.max(1, currentPage-2); pg <=Math.min(totalPages, currentPage+2); pg++) { %>
                            <a href="/nomenklatur?page=<%= pg %>&search=<%= encodeURIComponent(search) %>"
                              class="fw-page-btn <%= pg === currentPage ? 'active' : '' %>">
                              <%= pg %>
                            </a>
                            <% } %>
                              <% if (currentPage < totalPages) { %>
                                <a href="/nomenklatur?page=<%= currentPage+1 %>&search=<%= encodeURIComponent(search) %>"
                                  class="fw-page-btn">›</a>
                                <% } %>
                    </div>
                    <% } %>
                </div>
                <% } %>
      </div>