<%# views/nomenklatur/show.ejs %>

<style>
  .pg-table th{ height:36px; padding:0 1rem; text-align:left; font-size:0.65rem; font-weight:600; color:#a1a1aa; text-transform:uppercase; letter-spacing:0.06em; white-space:nowrap; }
  .pg-table th.center { text-align:center; }
  .pg-table td{ padding:0.75rem 1rem; font-size:0.8125rem; vertical-align:middle; }
  .pg-table tr{ border-bottom:1px solid #f4f4f5; transition:background 0.1s; }
  .pg-table tr:last-child{ border-bottom:none; }
  .pg-table tr:hover{ background:#fafafa; }
  .action-btn    { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:7px; color:#a1a1aa; transition:all 0.1s; border:none; background:transparent; cursor:pointer; }
  .action-btn:hover      { background:#f4f4f5; color:#18181b; }
  .action-btn.edit:hover { background:#fffbeb; color:#d97706; }
  .action-btn.del:hover  { background:#fef2f2; color:#dc2626; }
</style>

<%# ── Page Header ── %>
<div style="display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.25rem;">
  <div>
    <a href="/nomenklatur" style="display:inline-flex;align-items:center;gap:4px;font-size:0.75rem;color:#a1a1aa;text-decoration:none;margin-bottom:0.375rem;" onmouseover="this.style.color='#18181b'" onmouseout="this.style.color='#a1a1aa'">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      Kembali ke Daftar
    </a>
    <h1 style="font-size:1.25rem;font-weight:600;color:#18181b;margin:0 0 0.375rem;"><%= nom.name %></h1>
    <div style="display:flex;align-items:center;gap:0.5rem;">
      <code style="background:#f4f4f5;border-radius:5px;padding:2px 8px;font-size:0.75rem;font-family:monospace;color:#52525b;"><%= nom.grade %></code>
      <span style="display:inline-flex;align-items:center;border-radius:999px;padding:2px 10px;font-size:0.7rem;font-weight:500;background:#f4f4f5;color:#52525b;border:1px solid #e4e4e7;"><%= klasifikasi.length %> klasifikasi</span>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:0.5rem;">
    <a href="/nomenklatur/<%= nom.id %>/edit" class="btn-sm-outline">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Edit
    </a>
    <button type="button" class="btn-sm-destructive"
      data-name="<%= nom.name %>"
      onclick="fwShowDeleteModal('/nomenklatur/<%= nom.id %>', this.dataset.name)">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
      Hapus
    </button>
  </div>
</div>

<%# ── Detail Card ── %>
<div data-slot="card" class="rounded-xl border bg-card text-card-foreground shadow-sm" style="margin-bottom:1rem;">
  <div style="display:flex;align-items:center;gap:0.625rem;padding:0.875rem 1.25rem;border-bottom:1px solid #f4f4f5;">
    <div style="width:28px;height:28px;border-radius:7px;background:#eef2ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.75"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
    </div>
    <h2 style="font-size:0.8125rem;font-weight:600;color:#18181b;margin:0;">Informasi Nomenklatur</h2>
  </div>
  <div style="padding:0 1.25rem;">
    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;border-bottom:1px solid #f4f4f5;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Nama Nomenklatur</span>
      <span style="font-size:0.75rem;color:#18181b;text-align:right;"><%= nom.name %></span>
    </div>
    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;border-bottom:1px solid #f4f4f5;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Golongan / Grade</span>
      <span style="font-size:0.75rem;color:#18181b;text-align:right;"><code style="background:#f4f4f5;border-radius:4px;padding:1px 6px;font-family:monospace;font-size:0.7rem;"><%= nom.grade %></code></span>
    </div>
    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;border-bottom:1px solid #f4f4f5;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Kualifikasi</span>
      <span style="font-size:0.75rem;color:#18181b;text-align:right;white-space:pre-wrap;"><%= nom.qualification || '—' %></span>
    </div>
    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;border-bottom:1px solid #f4f4f5;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Uraian Tugas</span>
      <span style="font-size:0.75rem;color:#18181b;text-align:right;white-space:pre-wrap;"><%= nom.duties || '—' %></span>
    </div>
    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;border-bottom:1px solid #f4f4f5;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Dibuat</span>
      <span style="font-size:0.75rem;color:#18181b;text-align:right;"><%= nom.created_at ? new Date(nom.created_at).toLocaleDateString('id-ID',{dateStyle:'long'}) : '—' %></span>
    </div>
    <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.75rem 0;">
      <span style="font-size:0.75rem;color:#a1a1aa;flex-shrink:0;width:160px;">Terakhir diperbarui</span>
      <span style="font-size:0.75rem;color:#18181b;text-align:right;"><%= nom.updated_at ? new Date(nom.updated_at).toLocaleDateString('id-ID',{dateStyle:'long'}) : '—' %></span>
    </div>
  </div>
</div>

<%# ── Klasifikasi Card ── %>
<div data-slot="card" class="rounded-xl border bg-card text-card-foreground shadow-sm">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:0.875rem 1.25rem;border-bottom:1px solid #f4f4f5;">
    <div style="display:flex;align-items:center;gap:0.625rem;">
      <div style="width:28px;height:28px;border-radius:7px;background:#f0fdf4;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="1.75"><path d="M3 3h6v6H3z"/><path d="M15 3h6v6h-6z"/><path d="M3 15h6v6H3z"/><path d="M15 15h6v6h-6z"/></svg>
      </div>
      <h2 style="font-size:0.8125rem;font-weight:600;color:#18181b;margin:0;">Klasifikasi Jabatan</h2>
    </div>
    <span style="display:inline-flex;align-items:center;border-radius:999px;padding:2px 10px;font-size:0.7rem;font-weight:500;background:#f4f4f5;color:#52525b;border:1px solid #e4e4e7;"><%= klasifikasi.length %> klasifikasi</span>
  </div>

  <%# Form tambah klasifikasi %>
  <div style="padding:0.875rem 1.25rem;border-bottom:1px solid #f4f4f5;background:#fafafa;">
    <p style="font-size:0.75rem;font-weight:600;color:#18181b;margin:0 0 0.625rem;">Tambah Klasifikasi Baru</p>
    <form method="POST" action="/nomenklatur/<%= nom.id %>/klasifikasi" style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:flex-end;">
      <div style="flex:1;min-width:140px;">
        <label style="font-size:0.7rem;font-weight:500;color:#52525b;display:block;margin-bottom:4px;">Nama <span style="color:#dc2626;">*</span></label>
        <input type="text" name="name" data-slot="input" placeholder="Nama klasifikasi" required
          style="height:32px;width:100%;"
          class="rounded-md border border-input bg-transparent px-3 text-xs shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
      </div>
      <div style="flex:2;min-width:180px;">
        <label style="font-size:0.7rem;font-weight:500;color:#52525b;display:block;margin-bottom:4px;">Deskripsi</label>
        <input type="text" name="description" data-slot="input" placeholder="Deskripsi (opsional)"
          style="height:32px;width:100%;"
          class="rounded-md border border-input bg-transparent px-3 text-xs shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
      </div>
      <button type="submit" class="btn-sm" style="height:32px;padding:0 16px;font-size:0.75rem;flex-shrink:0;">Tambah</button>
    </form>
  </div>

  <% if (klasifikasi.length === 0) { %>
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:3rem 1.5rem;text-align:center;">
      <p style="font-size:0.875rem;color:#a1a1aa;margin:0 0 0.25rem;">Belum ada klasifikasi</p>
      <p style="font-size:0.75rem;color:#a1a1aa;margin:0;">Gunakan form di atas untuk menambahkan klasifikasi pertama</p>
    </div>
  <% } else { %>
    <div style="overflow-x:auto;">
      <table class="pg-table" style="width:100%;border-collapse:collapse;">
        <thead style="background:#fafafa;border-bottom:1px solid #f4f4f5;">
          <tr>
            <th class="center" style="width:36px;">#</th>
            <th>Nama Klasifikasi</th>
            <th>Deskripsi</th>
            <th class="center" style="width:80px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% klasifikasi.forEach((k, i) => { %>
            <tr id="row-k-<%= k.id %>">
              <td style="text-align:center;color:#a1a1aa;font-size:0.7rem;"><%= i + 1 %></td>
              <td id="kname-<%= k.id %>" style="font-weight:500;color:#18181b;"><%= k.name %></td>
              <td style="color:#71717a;"><%= k.description || '—' %></td>
              <td>
                <div style="display:flex;align-items:center;justify-content:center;gap:2px;">
                  <button type="button" class="action-btn edit" title="Edit"
                    data-id="<%= k.id %>" data-name="<%= k.name %>" data-desc="<%= k.description || '' %>"
                    onclick="openEditKlasifikasi(this.dataset.id, this.dataset.name, this.dataset.desc)">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </button>
                  <button type="button" class="action-btn del" title="Hapus"
                    data-nomid="<%= nom.id %>" data-kid="<%= k.id %>" data-kname="<%= k.name %>"
                    onclick="fwShowDeleteModal('/nomenklatur/' + this.dataset.nomid + '/klasifikasi/' + this.dataset.kid, this.dataset.kname)">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%# Modal Edit Klasifikasi %>
<div id="modal-klasifikasi" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); backdrop-filter:blur(2px); z-index:9998; align-items:center; justify-content:center;">
  <div style="background:#fff;border:1px solid #e4e4e7;border-radius:12px;padding:1.5rem;width:100%;max-width:420px;margin:1rem;box-shadow:0 24px 64px rgba(0,0,0,0.18);">
    <h3 style="font-size:0.875rem;font-weight:600;color:#18181b;margin:0 0 1rem;">Edit Klasifikasi</h3>
    <form id="form-edit-klasifikasi" method="POST" action="" style="display:flex;flex-direction:column;gap:0.875rem;">
      <input type="hidden" name="_method" value="PUT">
      <div>
        <label style="font-size:0.75rem;font-weight:500;color:#18181b;display:block;margin-bottom:5px;">Nama Klasifikasi <span style="color:#dc2626;">*</span></label>
        <input type="text" id="edit-klas-name" name="name" required data-slot="input"
          class="h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50">
      </div>
      <div>
        <label style="font-size:0.75rem;font-weight:500;color:#18181b;display:block;margin-bottom:5px;">Deskripsi</label>
        <input type="text" id="edit-klas-desc" name="description" data-slot="input"
          class="h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50">
      </div>
      <div style="display:flex;align-items:center;justify-content:flex-end;gap:0.5rem;padding-top:0.25rem;border-top:1px solid #f4f4f5;margin-top:0.25rem;">
        <button type="button" onclick="closeModal()" class="btn-sm-outline">Batal</button>
        <button type="submit" class="btn-sm">Simpan</button>
      </div>
    </form>
  </div>
</div>

<script>
function openEditKlasifikasi(kid, name, desc) {
  document.getElementById('edit-klas-name').value = name;
  document.getElementById('edit-klas-desc').value = desc;
  document.getElementById('form-edit-klasifikasi').action = '/nomenklatur/<%= nom.id %>/klasifikasi/' + kid;
  document.getElementById('modal-klasifikasi').style.display = 'flex';
}
function closeModal() {
  document.getElementById('modal-klasifikasi').style.display = 'none';
}
document.getElementById('modal-klasifikasi').addEventListener('click', function(e) {
  if (e.target === this) closeModal();
});
</script>