<%# views/nomenklatur/show.ejs %>

<%# ── Breadcrumb + aksi ──────────────────────────────────── %>
<div class="fw-page-header">
  <div>
    <a href="/nomenklatur" style="font-size:0.8rem; color:#94a3b8; text-decoration:none; display:inline-flex; align-items:center; gap:0.3rem; margin-bottom:0.5rem; transition:color 0.15s;"
       onmouseover="this.style.color='#64748b'" onmouseout="this.style.color='#94a3b8'">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      Nomenklatur Jabatan
    </a>
    <h1 class="fw-page-title"><%= nom.name %></h1>
    <div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.5rem;">
      <span class="fw-mono-chip"><%= nom.grade %></span>
      <span class="fw-badge fw-badge-dark"><%= klasifikasi.length %> klasifikasi</span>
    </div>
  </div>
  <div style="display:flex; gap:0.5rem; flex-shrink:0;">
    <a href="/nomenklatur/<%= nom.id %>/edit" class="fw-btn fw-btn-outline fw-btn-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Edit
    </a>
    <button type="button" class="fw-btn fw-btn-danger fw-btn-sm"
            data-id="<%= nom.id %>" data-name="<%= nom.name %>"
            onclick="fwShowDeleteModal('/nomenklatur/' + this.dataset.id, this.dataset.name)">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
      Hapus
    </button>
  </div>
</div>

<%# ── Detail Nomenklatur ─────────────────────────────────── %>
<div class="fw-card" style="margin-bottom:1.25rem;">
  <div class="fw-card-header">
    <div style="display:flex; align-items:center; gap:0.5rem;">
      <span style="font-size:1rem;">🏷️</span>
      <span style="font-size:0.875rem; font-weight:600; color:#0f172a;">Informasi Nomenklatur</span>
    </div>
  </div>
  <div class="fw-card-body">
    <div class="fw-detail-row">
      <span class="fw-detail-label">Nama Nomenklatur</span>
      <span class="fw-detail-value"><%= nom.name %></span>
    </div>
    <div class="fw-detail-row">
      <span class="fw-detail-label">Golongan / Grade</span>
      <span class="fw-detail-value"><span class="fw-mono-chip"><%= nom.grade %></span></span>
    </div>
    <div class="fw-detail-row">
      <span class="fw-detail-label">Kualifikasi</span>
      <span class="fw-detail-value" style="white-space:pre-wrap;"><%= nom.qualification || '—' %></span>
    </div>
    <div class="fw-detail-row">
      <span class="fw-detail-label">Uraian Tugas (Duties)</span>
      <span class="fw-detail-value" style="white-space:pre-wrap;"><%= nom.duties || '—' %></span>
    </div>
    <div class="fw-detail-row">
      <span class="fw-detail-label">Dibuat</span>
      <span class="fw-detail-value"><%= nom.created_at ? new Date(nom.created_at).toLocaleDateString('id-ID', {dateStyle:'long'}) : '—' %></span>
    </div>
    <div class="fw-detail-row">
      <span class="fw-detail-label">Terakhir diperbarui</span>
      <span class="fw-detail-value"><%= nom.updated_at ? new Date(nom.updated_at).toLocaleDateString('id-ID', {dateStyle:'long'}) : '—' %></span>
    </div>
  </div>
</div>

<%# ── Klasifikasi Jabatan ──────────────────────────────────── %>
<div class="fw-card">
  <div class="fw-card-header">
    <div style="display:flex; align-items:center; gap:0.5rem;">
      <span style="font-size:1rem;">📂</span>
      <span style="font-size:0.875rem; font-weight:600; color:#0f172a;">Klasifikasi Jabatan</span>
    </div>
    <span class="fw-badge fw-badge-dark"><%= klasifikasi.length %> klasifikasi</span>
  </div>
  <div class="fw-card-body">

    <%# Form tambah klasifikasi baru %>
    <div class="fw-form-section" style="margin-bottom:1.25rem;">
      <div class="fw-form-section-header">
        <span class="fw-form-section-title">Tambah Klasifikasi Baru</span>
      </div>
      <div class="fw-form-section-body">
        <form method="POST" action="/nomenklatur/<%= nom.id %>/klasifikasi"
              style="display:flex; gap:0.75rem; align-items:flex-end; flex-wrap:wrap;">
          <div style="flex:1; min-width:160px;">
            <label class="fw-label fw-label-required">Nama Klasifikasi</label>
            <input type="text" name="name" class="fw-input" placeholder="Nama klasifikasi" required>
          </div>
          <div style="flex:2; min-width:200px;">
            <label class="fw-label">Deskripsi</label>
            <input type="text" name="description" class="fw-input" placeholder="Deskripsi (opsional)">
          </div>
          <div>
            <label class="fw-label" style="visibility:hidden;">_</label>
            <button type="submit" class="fw-btn fw-btn-primary fw-btn-sm">Tambah</button>
          </div>
        </form>
      </div>
    </div>

    <% if (klasifikasi.length === 0) { %>
      <div class="fw-empty" style="padding:2rem 0;">
        <div class="fw-empty-title" style="font-size:0.9rem;">Belum ada klasifikasi</div>
        <div class="fw-empty-desc">Gunakan form di atas untuk menambahkan klasifikasi pertama</div>
      </div>
    <% } else { %>
      <div class="fw-table-wrap">
        <table class="fw-table">
          <thead>
            <tr>
              <th style="width:36px; text-align:center;">#</th>
              <th>Nama Klasifikasi</th>
              <th>Deskripsi</th>
              <th style="width:80px; text-align:center;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% klasifikasi.forEach((k, i) => { %>
              <tr id="row-k-<%= k.id %>">
                <td style="text-align:center; color:#c8ccda; font-size:0.75rem;"><%= i + 1 %></td>
                <td><div class="fw-cell-name" id="kname-<%= k.id %>"><%= k.name %></div></td>
                <td class="fw-cell-muted"><%= k.description || '—' %></td>
                <td>
                  <div class="fw-action-btns">
                    <button type="button" class="fw-action-btn fw-action-warn" title="Edit"
                            data-id="<%= k.id %>" data-name="<%= k.name %>" data-desc="<%= k.description || '' %>"
                            onclick="openEditKlasifikasi(this.dataset.id, this.dataset.name, this.dataset.desc)">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </button>
                    <button type="button" class="fw-action-btn fw-action-danger" title="Hapus"
                            data-nomid="<%= nom.id %>" data-kid="<%= k.id %>" data-kname="<%= k.name %>"
                            onclick="fwShowDeleteModal('/nomenklatur/' + this.dataset.nomid + '/klasifikasi/' + this.dataset.kid, this.dataset.kname)">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%# ── Modal Edit Klasifikasi ─────────────────────────────── %>
<div id="modal-klasifikasi" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.5); z-index:1000; align-items:center; justify-content:center;">
  <div style="background:#fff; border:1px solid #e2e8f0; border-radius:0.75rem; padding:1.5rem; width:100%; max-width:460px; margin:1rem; box-shadow:0 20px 60px rgba(0,0,0,0.15);">
    <div style="font-size:1rem; font-weight:600; color:#0f172a; margin-bottom:1rem;">Edit Klasifikasi</div>
    <form id="form-edit-klasifikasi" method="POST" action="">
      <input type="hidden" name="_method" value="PUT">
      <div style="margin-bottom:0.75rem;">
        <label class="fw-label fw-label-required">Nama Klasifikasi</label>
        <input type="text" id="edit-klas-name" name="name" class="fw-input" required>
      </div>
      <div style="margin-bottom:1rem;">
        <label class="fw-label">Deskripsi</label>
        <input type="text" id="edit-klas-desc" name="description" class="fw-input">
      </div>
      <div style="display:flex; gap:0.5rem; justify-content:flex-end;">
        <button type="button" class="fw-btn fw-btn-ghost fw-btn-sm" onclick="closeModal()">Batal</button>
        <button type="submit" class="fw-btn fw-btn-primary fw-btn-sm">Simpan</button>
      </div>
    </form>
  </div>
</div>

<script>
function openEditKlasifikasi(kid, name, desc) {
  document.getElementById('edit-klas-name').value = name;
  document.getElementById('edit-klas-desc').value = desc;
  document.getElementById('form-edit-klasifikasi').action = '/nomenklatur/<%= nom.id %>/klasifikasi/' + kid;
  document.getElementById('modal-klasifikasi').style.display = 'flex';
}
function closeModal() {
  document.getElementById('modal-klasifikasi').style.display = 'none';
}
document.getElementById('modal-klasifikasi').addEventListener('click', function(e) {
  if (e.target === this) closeModal();
});
</script>