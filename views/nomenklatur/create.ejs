<%# views/nomenklatur/create.ejs %>

<div class="fw-page-header">
  <div>
    <a href="/nomenklatur" style="font-size:0.8rem; color:#94a3b8; text-decoration:none; display:inline-flex; align-items:center; gap:0.3rem; margin-bottom:0.5rem;" onmouseover="this.style.color='#64748b'" onmouseout="this.style.color='#94a3b8'">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      Kembali
    </a>
    <h1 class="fw-page-title">Tambah Nomenklatur Baru</h1>
    <p class="fw-page-subtitle">Masukkan data nomenklatur jabatan secara lengkap</p>
  </div>
</div>

<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="fw-alert fw-alert-error">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0; margin-top:1px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <div>
      <div style="font-weight:600; margin-bottom:0.25rem;">Terdapat <%= errors.length %> kesalahan</div>
      <ul style="margin:0; padding-left:1rem; font-size:0.8rem;">
        <% errors.forEach(e => { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  </div>
<% } %>

<form action="/nomenklatur" method="POST">

  <%# Identitas Nomenklatur %>
  <div class="fw-form-section">
    <div class="fw-form-section-header">
      <span style="font-size:1rem;">🏷️</span>
      <span class="fw-form-section-title">Identitas Nomenklatur</span>
    </div>
    <div class="fw-form-section-body">
      <div class="fw-grid-2">
        <div class="fw-col-span-2">
          <label class="fw-label fw-label-required">Nama Nomenklatur</label>
          <input type="text" name="name" value="<%= old.name || '' %>" required class="fw-input" placeholder="Contoh: Analis Kepegawaian Ahli Muda">
        </div>
        <div class="fw-col-span-2">
          <label class="fw-label fw-label-required">Golongan / Grade</label>
          <input type="text" name="grade" value="<%= old.grade || '' %>" required class="fw-input" placeholder="Contoh: III/b">
        </div>
      </div>
    </div>
  </div>

  <%# Uraian Jabatan %>
  <div class="fw-form-section">
    <div class="fw-form-section-header">
      <span style="font-size:1rem;">📋</span>
      <span class="fw-form-section-title">Uraian Jabatan</span>
    </div>
    <div class="fw-form-section-body">
      <div class="fw-grid-2">
        <div class="fw-col-span-2">
          <label class="fw-label fw-label-required">Kualifikasi</label>
          <textarea name="qualification" rows="4" class="fw-input" style="resize:vertical;" required placeholder="Jelaskan kualifikasi / persyaratan jabatan ini..."><%= old.qualification || '' %></textarea>
        </div>
        <div class="fw-col-span-2">
          <label class="fw-label fw-label-required">Uraian Tugas (Duties)</label>
          <textarea name="duties" rows="4" class="fw-input" style="resize:vertical;" required placeholder="Jelaskan tugas pokok dan tanggung jawab jabatan ini..."><%= old.duties || '' %></textarea>
        </div>
      </div>
    </div>
  </div>

  <%# Tombol Aksi %>
  <div style="display:flex; align-items:center; gap:0.75rem; padding-top:0.5rem; margin-bottom:2rem;">
    <button type="submit" class="fw-btn fw-btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      Kembali
    </a>
  </div>

</form>