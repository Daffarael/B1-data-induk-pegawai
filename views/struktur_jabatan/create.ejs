<%# views/struktur_jabatan/create.ejs %>

    <style>
        .fw-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.125rem;
        }

        .fw-form-full {
            grid-column: 1 / -1;
        }

        .fw-field-label {
            display: block;
            font-size: 0.6875rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #71717a;
            margin-bottom: 8px;
        }

        .fw-field-req {
            color: #ef4444;
        }

        .fw-hint {
            font-size: 0.7rem;
            color: #a1a1aa;
            margin-top: 5px;
        }

        .fw-input {
            height: 44px !important;
            padding: 0 14px !important;
            font-size: 0.9375rem !important;
            border-radius: 8px !important;
        }

        .fw-select {
            height: 44px !important;
            padding: 0 14px !important;
            font-size: 0.9375rem !important;
            border-radius: 8px !important;
        }

        .fw-textarea {
            padding: 12px 14px !important;
            font-size: 0.9375rem !important;
            border-radius: 8px !important;
            line-height: 1.6 !important;
        }

        @media(max-width:640px) {
            .fw-form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <%# ── Page Header ── %>
        <div style="margin-bottom:1.5rem;">
            <a href="/struktur-jabatan"
                style="display:inline-flex;align-items:center;gap:5px;font-size:0.75rem;color:#a1a1aa;text-decoration:none;margin-bottom:0.75rem;"
                onmouseover="this.style.color='#18181b'" onmouseout="this.style.color='#a1a1aa'">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6" />
                </svg>
                Struktur Jabatan
            </a>
            <h1 style="font-size:1.125rem;font-weight:600;color:#18181b;margin:0 0 0.25rem;letter-spacing:-0.01em;">
                Tambah Jabatan Struktural</h1>
            <p style="font-size:0.8125rem;color:#a1a1aa;margin:0;">Isi form di bawah untuk menambahkan posisi struktur
                baru</p>
        </div>

        <form method="POST" action="/struktur-jabatan" style="display:flex;flex-direction:column;gap:0.875rem;">

            <div data-slot="card" class="rounded-xl border bg-card shadow-sm">
                <div
                    style="display:flex;align-items:center;gap:0.625rem;padding:1rem 1.5rem;border-bottom:1px solid #f4f4f5;">
                    <div
                        style="width:32px;height:32px;border-radius:8px;background:#eef2ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6366f1"
                            stroke-width="1.75">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                        </svg>
                    </div>
                    <span style="font-size:0.875rem;font-weight:600;color:#18181b;">Informasi Jabatan</span>
                </div>
                <div style="padding:1.5rem;">
                    <div class="fw-form-grid">

                        <div class="fw-form-full">
                            <label class="fw-field-label">Nama Jabatan <span class="fw-field-req">*</span></label>
                            <input type="text" name="name" value="<%= old.name || '' %>" required data-slot="input"
                                placeholder="Misal: Kepala Bagian Kepegawaian"
                                class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
                        </div>

                        <div class="fw-form-full">
                            <label class="fw-field-label">Golongan / Grade <span class="fw-field-req">*</span></label>
                            <input type="text" name="grade" value="<%= old.grade || '' %>" required data-slot="input"
                                placeholder="Misal: Eselon II.A"
                                class="fw-input w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
                        </div>

                        <div class="fw-form-full">
                            <label class="fw-field-label">Atasan Langsung (Parent)</label>
                            <select name="parent_id" data-slot="input"
                                class="fw-select w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
                                <option value="">- Pucuk Pimpinan (tidak ada atasan) -</option>
                                <% parents.forEach(p=> { %>
                                    <option value="<%= p.id %>" <%=old.parent_id==p.id ? 'selected' : '' %>><%= p.name
                                            %>
                                    </option>
                                    <% }) %>
                            </select>
                            <p class="fw-hint">Kosongkan jika ini adalah jabatan tertinggi di struktur.</p>
                        </div>

                        <div class="fw-form-full">
                            <label class="fw-field-label">Kualifikasi Jabatan</label>
                            <textarea name="qualification" rows="3" data-slot="textarea"
                                placeholder="Syarat pendidikan, pengalaman, dll..."
                                class="fw-textarea w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 resize-none transition-[color,box-shadow]"><%= old.qualification || '' %></textarea>
                        </div>

                        <div class="fw-form-full">
                            <label class="fw-field-label">Deskripsi Tambahan</label>
                            <textarea name="description" rows="3" data-slot="textarea"
                                placeholder="Keterangan lainnya..."
                                class="fw-textarea w-full min-w-0 rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 resize-none transition-[color,box-shadow]"><%= old.description || '' %></textarea>
                        </div>

                    </div>
                </div>
            </div>

            <%# Action Buttons %>
                <div style="display:flex;align-items:center;justify-content:flex-end;gap:0.75rem;padding-top:0.25rem;">
                    <a href="/struktur-jabatan" class="btn-outline"
                        style="height:44px;padding:0 1.5rem;font-size:0.9375rem;display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;white-space:nowrap;">
                        Batal
                    </a>
                    <button type="submit" class="btn"
                        style="height:44px;padding:0 1.5rem;font-size:0.9375rem;display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;white-space:nowrap;">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                        Simpan Data
                    </button>
                </div>

        </form>

        <script>
            /* ── Client-side Validation ── */
            (function () {
                const form = document.querySelector('form[action="/struktur-jabatan"]');
                if (!form) return;

                function showError(fieldName, msg) {
                    const el = form.querySelector(`[name="${fieldName}"]`);
                    if (!el) return;
                    el.style.borderColor = '#ef4444';
                    let errEl = el.parentElement.querySelector('.cv-err');
                    if (!errEl) {
                        errEl = document.createElement('p');
                        errEl.className = 'cv-err';
                        errEl.style.cssText = 'font-size:0.7rem;color:#ef4444;margin:4px 0 0;';
                        el.parentElement.appendChild(errEl);
                    }
                    errEl.textContent = msg;
                }

                function clearErrors() {
                    form.querySelectorAll('.cv-err').forEach(e => e.remove());
                    form.querySelectorAll('[name]').forEach(el => el.style.borderColor = '');
                }

                form.addEventListener('submit', function (e) {
                    clearErrors();
                    const errors = [];
                    const val = name => (form.querySelector(`[name="${name}"]`)?.value || '').trim();

                    // Hanya Nama dan Grade yang wajib
                    const rules = [
                        { field: 'name', label: 'Nama Jabatan' },
                        { field: 'grade', label: 'Golongan / Grade' },
                    ];

                    rules.forEach(r => {
                        if (!val(r.field)) {
                            showError(r.field, `${r.label} wajib diisi`);
                            errors.push(r.label);
                        }
                    });

                    if (errors.length > 0) {
                        e.preventDefault();
                        const firstErr = form.querySelector('.cv-err');
                        if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                });

                form.querySelectorAll('input, textarea').forEach(el => {
                    el.addEventListener('input', function () {
                        this.style.borderColor = '';
                        const err = this.parentElement.querySelector('.cv-err');
                        if (err) err.remove();
                    });
                });
            })();
        </script>