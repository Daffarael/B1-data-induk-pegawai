<%# partials/flash.ejs — flash messages berwarna %>

  <% if (success && success.length> 0) { %>
    <% success.forEach(msg=> { %>
      <div class="flash-alert" role="alert"
        style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;border-radius:8px;border:1px solid #bbf7d0;background:#dcfce7;color:#166534;font-size:0.8375rem;font-weight:500;margin-bottom:0.875rem;position:relative;padding-right:2.5rem;animation:flash-in 0.2s ease;">
        <%# icon centang %>
          <svg style="flex-shrink:0;color:#16a34a;" width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          <span style="flex:1;line-height:1.5;">
            <%= msg %>
          </span>
          <button onclick="dismissFlash(this)"
            style="position:absolute;right:0.625rem;top:50%;transform:translateY(-50%);width:24px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:5px;border:none;background:transparent;color:#166534;cursor:pointer;opacity:0.6;font-size:0.875rem;transition:opacity 0.15s,background 0.15s;"
            onmouseover="this.style.opacity='1';this.style.background='rgba(22,163,74,0.12)';"
            onmouseout="this.style.opacity='0.6';this.style.background='transparent';">✕</button>
      </div>
      <% }) %>
        <% } %>

          <% if (error && error.length> 0) { %>
            <% error.forEach(msg=> { %>
              <div class="flash-alert" role="alert"
                style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;border-radius:8px;border:1px solid #fecaca;background:#fee2e2;color:#991b1b;font-size:0.8375rem;font-weight:500;margin-bottom:0.875rem;position:relative;padding-right:2.5rem;animation:flash-in 0.2s ease;">
                <%# icon error %>
                  <svg style="flex-shrink:0;color:#dc2626;" width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                  </svg>
                  <span style="flex:1;line-height:1.5;">
                    <%= msg %>
                  </span>
                  <button onclick="dismissFlash(this)"
                    style="position:absolute;right:0.625rem;top:50%;transform:translateY(-50%);width:24px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:5px;border:none;background:transparent;color:#991b1b;cursor:pointer;opacity:0.6;font-size:0.875rem;transition:opacity 0.15s,background 0.15s;"
                    onmouseover="this.style.opacity='1';this.style.background='rgba(220,38,38,0.12)';"
                    onmouseout="this.style.opacity='0.6';this.style.background='transparent';">✕</button>
              </div>
              <% }) %>
                <% } %>

                  <% if (typeof warning !=='undefined' && warning && warning.length> 0) { %>
                    <% warning.forEach(msg=> { %>
                      <div class="flash-alert" role="alert"
                        style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;border-radius:8px;border:1px solid #fde68a;background:#fef9c3;color:#854d0e;font-size:0.8375rem;font-weight:500;margin-bottom:0.875rem;position:relative;padding-right:2.5rem;animation:flash-in 0.2s ease;">
                        <svg style="flex-shrink:0;color:#d97706;" width="16" height="16" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path
                            d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                          <line x1="12" y1="9" x2="12" y2="13" />
                          <line x1="12" y1="17" x2="12.01" y2="17" />
                        </svg>
                        <span style="flex:1;line-height:1.5;">
                          <%= msg %>
                        </span>
                        <button onclick="dismissFlash(this)"
                          style="position:absolute;right:0.625rem;top:50%;transform:translateY(-50%);width:24px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:5px;border:none;background:transparent;color:#854d0e;cursor:pointer;opacity:0.6;font-size:0.875rem;transition:opacity 0.15s,background 0.15s;"
                          onmouseover="this.style.opacity='1';this.style.background='rgba(217,119,6,0.12)';"
                          onmouseout="this.style.opacity='0.6';this.style.background='transparent';">✕</button>
                      </div>
                      <% }) %>
                        <% } %>

                          <% if (typeof info !=='undefined' && info && info.length> 0) { %>
                            <% info.forEach(msg=> { %>
                              <div class="flash-alert" role="alert"
                                style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;border-radius:8px;border:1px solid #bfdbfe;background:#dbeafe;color:#1e40af;font-size:0.8375rem;font-weight:500;margin-bottom:0.875rem;position:relative;padding-right:2.5rem;animation:flash-in 0.2s ease;">
                                <svg style="flex-shrink:0;color:#2563eb;" width="16" height="16" viewBox="0 0 24 24"
                                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                  stroke-linejoin="round">
                                  <circle cx="12" cy="12" r="10" />
                                  <line x1="12" y1="16" x2="12" y2="12" />
                                  <line x1="12" y1="8" x2="12.01" y2="8" />
                                </svg>
                                <span style="flex:1;line-height:1.5;">
                                  <%= msg %>
                                </span>
                                <button onclick="dismissFlash(this)"
                                  style="position:absolute;right:0.625rem;top:50%;transform:translateY(-50%);width:24px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:5px;border:none;background:transparent;color:#1e40af;cursor:pointer;opacity:0.6;font-size:0.875rem;transition:opacity 0.15s,background 0.15s;"
                                  onmouseover="this.style.opacity='1';this.style.background='rgba(37,99,235,0.12)';"
                                  onmouseout="this.style.opacity='0.6';this.style.background='transparent';">✕</button>
                              </div>
                              <% }) %>
                                <% } %>

                                  <style>
                                    @keyframes flash-in {
                                      from {
                                        opacity: 0;
                                        transform: translateY(-6px);
                                      }

                                      to {
                                        opacity: 1;
                                        transform: translateY(0);
                                      }
                                    }
                                  </style>
                                  <script>
                                    function dismissFlash(btn) {
                                      const el = btn.closest ? btn.closest('.flash-alert') : btn;
                                      el.style.transition = 'opacity 0.25s, transform 0.25s';
                                      el.style.opacity = '0';
                                      el.style.transform = 'translateY(-4px)';
                                      setTimeout(() => el.remove(), 250);
                                    }
                                    document.querySelectorAll('.flash-alert').forEach(el => {
                                      setTimeout(() => {
                                        if (el.isConnected) {
                                          const btn = el.querySelector('button');
                                          dismissFlash(btn || el);
                                        }
                                      }, 5000);
                                    });
                                  </script>