<%# views/pegawai/index.ejs %>

<style>
  .pg-stats   { display:grid; grid-template-columns:repeat(4,1fr); gap:0.75rem; margin-bottom:1.125rem; }
  .pg-stat    { background:#fff; border:1px solid #e4e4e7; border-radius:12px; padding:1rem 1.125rem; }
  .pg-icon    { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .pg-table th{ height:36px; padding:0 1rem; text-align:left; font-size:0.65rem; font-weight:600; color:#a1a1aa; text-transform:uppercase; letter-spacing:0.06em; white-space:nowrap; }
  .pg-table th.center { text-align:center; }
  .pg-table td{ padding:0.75rem 1rem; font-size:0.8125rem; vertical-align:middle; }
  .pg-table tr{ border-bottom:1px solid #f4f4f5; transition:background 0.1s; }
  .pg-table tr:last-child{ border-bottom:none; }
  .pg-table tr:hover{ background:#fafafa; }
  .badge-active  { display:inline-flex; align-items:center; gap:4px; border-radius:999px; padding:2px 8px; font-size:0.7rem; font-weight:500; background:#f0fdf4; color:#16a34a; border:1px solid #bbf7d0; }
  .badge-inactive{ display:inline-flex; align-items:center; gap:4px; border-radius:999px; padding:2px 8px; font-size:0.7rem; font-weight:500; background:#fef2f2; color:#dc2626; border:1px solid #fecaca; }
  .badge-dot     { width:5px; height:5px; border-radius:50%; display:inline-block; flex-shrink:0; }
  .action-btn     { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:7px; color:#a1a1aa; transition:all 0.1s; border:none; background:transparent; cursor:pointer; text-decoration:none; }
  .action-btn:hover       { background:#f4f4f5; color:#18181b; }
  .action-btn.view:hover  { background:#eef2ff; color:#6366f1; }
  .action-btn.edit:hover  { background:#fffbeb; color:#d97706; }
  .action-btn.del:hover   { background:#fef2f2; color:#dc2626; }
  .pg-num         { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:7px; border:1px solid #e4e4e7; font-size:0.75rem; color:#52525b; text-decoration:none; background:#fff; transition:all 0.1s; }
  .pg-num:hover   { background:#f4f4f5; }
  .pg-num.active  { background:#18181b; border-color:#18181b; color:#fff; font-weight:600; }
  @media(max-width:900px){ .pg-stats{ grid-template-columns:repeat(2,1fr); } }
</style>

<%# ── Stat Cards ──────────────────────────────────────── %>
<div class="pg-stats">

  <div class="pg-stat">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
      <span style="font-size:0.65rem;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;">Total</span>
      <div class="pg-icon" style="background:#f4f4f5;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#71717a" stroke-width="1.75"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
    </div>
    <div style="font-size:1.625rem;font-weight:700;color:#18181b;letter-spacing:-0.03em;line-height:1;"><%= total %></div>
    <div style="font-size:0.7rem;color:#a1a1aa;margin-top:0.25rem;">pegawai terdaftar</div>
  </div>

  <div class="pg-stat">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
      <span style="font-size:0.65rem;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;">Dosen</span>
      <div class="pg-icon" style="background:#eef2ff;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.75"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
      </div>
    </div>
    <div style="font-size:1.625rem;font-weight:700;color:#18181b;letter-spacing:-0.03em;line-height:1;"><%= totalDosen %></div>
    <div style="font-size:0.7rem;color:#a1a1aa;margin-top:0.25rem;">terdaftar</div>
  </div>

  <div class="pg-stat">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
      <span style="font-size:0.65rem;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;">Staf</span>
      <div class="pg-icon" style="background:#f0fdf4;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="1.75"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
      </div>
    </div>
    <div style="font-size:1.625rem;font-weight:700;color:#18181b;letter-spacing:-0.03em;line-height:1;"><%= totalStaf %></div>
    <div style="font-size:0.7rem;color:#a1a1aa;margin-top:0.25rem;">terdaftar</div>
  </div>

  <div class="pg-stat">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
      <span style="font-size:0.65rem;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;">Aktif</span>
      <div class="pg-icon" style="background:#ecfdf5;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="1.75"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
    </div>
    <div style="font-size:1.625rem;font-weight:700;color:#18181b;letter-spacing:-0.03em;line-height:1;"><%= totalAktif %></div>
    <div style="font-size:0.7rem;color:#a1a1aa;margin-top:0.25rem;">aktif</div>
  </div>

</div>

<%# ── Main Card ──────────────────────────────────────────── %>
<div data-slot="card" class="rounded-xl border bg-card text-card-foreground shadow-sm">

  <%# Toolbar %>
  <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.5rem;padding:0.75rem 1rem;border-bottom:1px solid #f4f4f5;">
    <form method="GET" action="/pegawai" style="display:flex;flex-wrap:wrap;align-items:center;gap:0.5rem;flex:1;min-width:0;">
      <div style="position:relative;">
        <svg style="position:absolute;left:9px;top:50%;transform:translateY(-50%);color:#a1a1aa;" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" name="search" value="<%= search %>" placeholder="Cari nama atau NIP…"
          data-slot="input"
          style="height:32px;padding-left:30px;padding-right:12px;width:200px;"
          class="rounded-md border border-input bg-transparent text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
      </div>
      <select name="status" style="height:32px;padding:0 10px;width:148px;"
        class="rounded-md border border-input bg-background text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-[color,box-shadow]">
        <option value="">Semua Status</option>
        <option value="active"   <%=statusFilter==='active'   ?'selected':''%>>Aktif</option>
        <option value="inactive" <%=statusFilter==='inactive' ?'selected':''%>>Tidak Aktif</option>
      </select>
      <button type="submit" data-slot="button" data-variant="default" data-size="sm"
        class="h-8 px-3 inline-flex shrink-0 items-center justify-center rounded-md text-xs font-medium bg-primary text-primary-foreground hover:bg-primary/90 transition-all outline-none">Cari</button>
      <a href="/pegawai" data-slot="button" data-variant="outline" data-size="sm"
        class="h-8 px-3 inline-flex shrink-0 items-center justify-center rounded-md text-xs font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground transition-all outline-none">Reset</a>
    </form>
    <div style="display:flex;align-items:center;gap:0.375rem;margin-left:auto;">
      <a href="/pegawai/export/pdf/preview?search=<%=encodeURIComponent(search)%>&status=<%=statusFilter%>" data-slot="button" data-variant="outline" data-size="sm"
        class="h-8 px-3 inline-flex shrink-0 items-center justify-center gap-1 rounded-md text-xs font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground transition-all outline-none">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Export PDF</a>
      <a href="/pegawai/export/json/preview?search=<%=encodeURIComponent(search)%>&status=<%=statusFilter%>" data-slot="button" data-variant="outline" data-size="sm"
        class="h-8 px-3 inline-flex shrink-0 items-center justify-center gap-1 rounded-md text-xs font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground transition-all outline-none">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>Export JSON</a>
      <a href="/pegawai/create" data-slot="button" data-variant="default" data-size="sm"
        class="h-8 px-3 inline-flex shrink-0 items-center justify-center gap-1 rounded-md text-xs font-medium bg-primary text-primary-foreground hover:bg-primary/90 transition-all outline-none">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Tambah</a>
    </div>
  </div>

  <%# Import CSV %>
  <div style="padding:0.375rem 1rem;border-bottom:1px solid #f4f4f5;background:#fafafa;">
    <details>
      <summary style="font-size:0.7rem;color:#a1a1aa;cursor:pointer;display:flex;align-items:center;gap:6px;padding:4px 0;list-style:none;user-select:none;" class="hover:text-foreground transition-colors">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        Import dari CSV
      </summary>
      <div style="padding:0.625rem 0 0.375rem;">
        <form method="POST" action="/pegawai/import" enctype="multipart/form-data">
          <div style="display:flex;align-items:center;gap:0.625rem;flex-wrap:wrap;">

            <%# Hidden actual file input %>
            <input type="file" name="csv_file" accept=".csv" id="csvFileInput"
              style="position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;clip:rect(0,0,0,0);">

            <%# Styled label as file picker trigger %>
            <label for="csvFileInput" data-slot="button" data-variant="outline"
              style="height:32px;padding:0 0.875rem;font-size:0.75rem;display:inline-flex;align-items:center;gap:6px;border-radius:6px;cursor:pointer;"
              class="shrink-0 font-medium border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground transition-all whitespace-nowrap">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              Pilih File CSV
            </label>

            <%# File name preview badge %>
            <span id="csvFileName"
              style="font-size:0.7rem;color:#71717a;padding:0 0.625rem;height:32px;display:inline-flex;align-items:center;gap:5px;border:1px solid #e4e4e7;border-radius:6px;background:#fafafa;min-width:140px;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span id="csvFileNameText" style="color:#a1a1aa;font-style:italic;">Belum ada file dipilih</span>
            </span>

            <button type="submit" data-slot="button"
              style="height:32px;padding:0 0.875rem;font-size:0.75rem;background:#059669;color:#fff;border:none;border-radius:6px;display:inline-flex;align-items:center;gap:5px;font-weight:500;cursor:pointer;transition:background 0.12s;"
              onmouseover="this.style.background='#047857'" onmouseout="this.style.background='#059669'">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Upload & Import
            </button>
          </div>

          <p style="font-size:0.65rem;color:#a1a1aa;margin-top:8px;">
            Kolom: <code style="background:#f4f4f5;padding:1px 5px;border-radius:4px;font-size:0.65rem;">employee_number, name, birth_place, birth_date, gender, address, organization_unit_id, hire_date, employment_status_id, status</code>
          </p>
        </form>

        <script>
          document.getElementById('csvFileInput').addEventListener('change', function() {
            const nameEl = document.getElementById('csvFileNameText');
            if (this.files && this.files[0]) {
              nameEl.textContent = this.files[0].name;
              nameEl.style.color = '#18181b';
              nameEl.style.fontStyle = 'normal';
            } else {
              nameEl.textContent = 'Belum ada file dipilih';
              nameEl.style.color = '#a1a1aa';
              nameEl.style.fontStyle = 'italic';
            }
          });
        </script>
      </div>

    </details>
  </div>

  <%# Empty State %>
  <% if (pegawai.length === 0) { %>
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:4rem 1.5rem;text-align:center;">
      <div style="width:48px;height:48px;border-radius:12px;background:#f4f4f5;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <p style="font-size:0.875rem;font-weight:600;color:#18181b;margin:0 0 0.25rem;">Belum ada data pegawai</p>
      <p style="font-size:0.75rem;color:#a1a1aa;margin:0 0 1.25rem;">Klik "Tambah" untuk menambahkan data baru</p>
      <a href="/pegawai/create" data-slot="button" data-variant="default" data-size="sm"
        class="h-8 px-4 inline-flex items-center justify-center gap-1 rounded-md text-xs font-medium bg-primary text-primary-foreground hover:bg-primary/90 transition-all outline-none">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tambah Pegawai
      </a>
    </div>

  <% } else { %>
    <div style="overflow-x:auto;">
      <table class="pg-table" style="width:100%;border-collapse:collapse;">
        <thead style="background:#fafafa;border-bottom:1px solid #f4f4f5;">
          <tr>
            <th class="center" style="width:36px;">#</th>
            <th>NIP</th>
            <th>Nama</th>
            <th>Tipe</th>
            <th>Unit</th>
            <th>Tgl Masuk</th>
            <th>Status</th>
            <th class="center" style="width:88px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% pegawai.forEach((p, i) => { %>
            <tr>
              <td style="text-align:center;color:#a1a1aa;font-size:0.7rem;"><%= (currentPage-1)*10+i+1 %></td>
              <td><code style="background:#f4f4f5;border-radius:5px;padding:2px 6px;font-size:0.7rem;font-family:monospace;"><%= p.employee_number %></code></td>
              <td>
                <div style="font-size:0.8125rem;font-weight:500;color:#18181b;"><%= p.name %></div>
                <% if (p.phone_number) { %>
                  <div style="font-size:0.7rem;color:#a1a1aa;"><%= p.phone_number %></div>
                <% } %>
              </td>
              <td>
                <% if (p.employee_type==='Dosen') { %>
                  <span data-slot="badge" data-variant="default" class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium border-transparent bg-primary text-primary-foreground">Dosen</span>
                <% } else { %>
                  <span data-slot="badge" data-variant="secondary" class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium border-transparent bg-secondary text-secondary-foreground">Staf</span>
                <% } %>
              </td>
              <td style="font-size:0.75rem;color:#71717a;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= p.unit_name||'—' %></td>
              <td style="font-size:0.75rem;color:#71717a;white-space:nowrap;">
                <%= p.hire_date ? new Date(p.hire_date).toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'}) : '—' %>
              </td>
              <td>
                <% if (p.status==='active') { %>
                  <span class="badge-active"><span class="badge-dot" style="background:#10b981;"></span>Aktif</span>
                <% } else { %>
                  <span class="badge-inactive"><span class="badge-dot" style="background:#ef4444;"></span>Nonaktif</span>
                <% } %>
              </td>
              <td>
                <div style="display:flex;align-items:center;justify-content:center;gap:2px;">
                  <a href="/pegawai/<%= p.id %>" class="action-btn" title="Detail">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  </a>
                  <a href="/pegawai/<%= p.id %>/edit" class="action-btn edit" title="Edit">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                  <button type="button" class="action-btn del" title="Hapus"
                    data-name="<%= p.name %>"
                    onclick="fwShowDeleteModal('/pegawai/<%= p.id %>', this.dataset.name)">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <%# Pagination footer %>
    <% if (totalPages > 1) { %>
    <div style="display:flex;align-items:center;justify-content:center;padding:0.625rem 1rem;border-top:1px solid #f4f4f5;">
      <div style="display:flex;align-items:center;gap:4px;">
        <% if (currentPage > 1) { %>
          <a href="/pegawai?page=<%=currentPage-1%>&search=<%=encodeURIComponent(search)%>&status=<%=statusFilter%>" class="pg-num">‹</a>
        <% } %>
        <% for(let pg=Math.max(1,currentPage-2); pg<=Math.min(totalPages,currentPage+2); pg++) { %>
          <a href="/pegawai?page=<%=pg%>&search=<%=encodeURIComponent(search)%>&status=<%=statusFilter%>" class="pg-num<%=pg===currentPage?' active':''%>"><%=pg%></a>
        <% } %>
        <% if (currentPage < totalPages) { %>
          <a href="/pegawai?page=<%=currentPage+1%>&search=<%=encodeURIComponent(search)%>&status=<%=statusFilter%>" class="pg-num">›</a>
        <% } %>
      </div>
    </div>
    <% } %>
  <% } %>

</div>