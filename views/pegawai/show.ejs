<%# views/pegawai/show.ejs %>

<%# ── Breadcrumb + aksi ──────────────────────────────────── %>
<div class="fw-page-header">
  <div>
    <a href="/pegawai" style="font-size:0.8rem; color:#94a3b8; text-decoration:none; display:inline-flex; align-items:center; gap:0.3rem; margin-bottom:0.5rem; transition:color 0.15s;" onmouseover="this.style.color='#64748b'" onmouseout="this.style.color='#94a3b8'">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      Kembali
    </a>
    <h1 class="fw-page-title"><%= pegawai.name %></h1>
    <div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.5rem; flex-wrap:wrap;">
      <span style="font-family:monospace; font-size:0.8rem; color:#64748b; background:#f1f5f9; padding:2px 8px; border-radius:4px; border:1px solid #e2e8f0;"><%= pegawai.employee_number %></span>
      <% if (pegawai.employee_type === 'Dosen') { %>
        <span class="fw-badge fw-badge-indigo">Dosen</span>
      <% } else { %>
        <span class="fw-badge fw-badge-slate">Staf</span>
      <% } %>
      <% if (pegawai.status === 'active') { %>
        <span class="fw-badge fw-badge-green">● Aktif</span>
      <% } else { %>
        <span class="fw-badge fw-badge-red">● Nonaktif</span>
      <% } %>
    </div>
  </div>
  <div style="display:flex; gap:0.5rem; flex-shrink:0;">
    <a href="/pegawai/<%= pegawai.id %>/edit" class="fw-btn fw-btn-outline fw-btn-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Edit
    </a>
    <button type="button" class="fw-btn fw-btn-danger fw-btn-sm"
            onclick="fwShowDeleteModal('/pegawai/<%= pegawai.id %>', '<%= pegawai.name.replace(/'/g, '\\\'') %>')">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
      Hapus
    </button>
  </div>
</div>

<%# ── Detail grid ────────────────────────────────────────── %>
<div class="fw-detail-grid">

  <%# Data Pribadi %>
  <div class="fw-card">
    <div class="fw-card-header">
      <div style="display:flex; align-items:center; gap:0.5rem;">
        <span style="font-size:1rem;">🪪</span>
        <span style="font-size:0.875rem; font-weight:600; color:#0f172a;">Data Pribadi</span>
      </div>
    </div>
    <div class="fw-card-body">
      <%
        const rows = [
          ['NIK', pegawai.national_id_number],
          ['NPWP', pegawai.tax_id_number],
          ['Tempat Lahir', pegawai.birth_place],
          ['Tanggal Lahir', pegawai.birth_date ? new Date(pegawai.birth_date).toLocaleDateString('id-ID', {day:'numeric', month:'long', year:'numeric'}) : null],
          ['Jenis Kelamin', pegawai.gender === 'male' ? 'Laki-laki' : 'Perempuan'],
          ['Agama', pegawai.religion],
          ['No. Telepon', pegawai.phone_number],
          ['Alamat', pegawai.address],
        ];
      %>
      <% rows.forEach(([label, val]) => { %>
        <div class="fw-detail-row">
          <span class="fw-detail-label"><%= label %></span>
          <span class="fw-detail-value"><%= val || '-' %></span>
        </div>
      <% }) %>
    </div>
  </div>

  <%# Data Kepegawaian %>
  <div style="display:flex; flex-direction:column; gap:1rem;">
    <div class="fw-card">
      <div class="fw-card-header">
        <div style="display:flex; align-items:center; gap:0.5rem;">
          <span style="font-size:1rem;">🏢</span>
          <span style="font-size:0.875rem; font-weight:600; color:#0f172a;">Data Kepegawaian</span>
        </div>
      </div>
      <div class="fw-card-body">
        <%
          const kepRows = [
            ['Unit Organisasi', pegawai.unit_name],
            ['Status Kepegawaian', pegawai.employment_status_name],
            ['Tanggal Masuk', pegawai.hire_date ? new Date(pegawai.hire_date).toLocaleDateString('id-ID', {day:'numeric', month:'long', year:'numeric'}) : null],
            ['Status', pegawai.status === 'active' ? 'Aktif' : 'Tidak Aktif'],
          ];
        %>
        <% kepRows.forEach(([label, val]) => { %>
          <div class="fw-detail-row">
            <span class="fw-detail-label"><%= label %></span>
            <span class="fw-detail-value"><%= val || '-' %></span>
          </div>
        <% }) %>
      </div>
    </div>

    <%# Data Dosen (hanya jika Dosen) %>
    <% if (pegawai.employee_type === 'Dosen') { %>
      <div class="fw-card" style="border-left: 3px solid #3d4158;">
        <div class="fw-card-header">
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <span style="font-size:1rem;">🎓</span>
            <span style="font-size:0.875rem; font-weight:600; color:#0f172a;">Data Akademik</span>
          </div>
          <span class="fw-badge fw-badge-indigo">Dosen</span>
        </div>
        <div class="fw-card-body">
          <div class="fw-detail-row">
            <span class="fw-detail-label">NIDN</span>
            <span class="fw-detail-value"><%= pegawai.nidn || '-' %></span>
          </div>
          <div class="fw-detail-row">
            <span class="fw-detail-label">Pangkat Akademik</span>
            <span class="fw-detail-value"><%= pegawai.academic_rank || '-' %></span>
          </div>
          <div class="fw-detail-row">
            <span class="fw-detail-label">Jabatan Fungsional</span>
            <span class="fw-detail-value"><%= pegawai.functional_position || '-' %></span>
          </div>
          <div class="fw-detail-row">
            <span class="fw-detail-label">Bidang Keahlian</span>
            <span class="fw-detail-value"><%= pegawai.expertise || '-' %></span>
          </div>
        </div>
      </div>
    <% } %>
  </div>

</div>
