<%# views/pegawai/create.ejs %>

<div class="fw-page-header">
  <div>
    <a href="/pegawai" style="font-size:0.8rem; color:#94a3b8; text-decoration:none; display:inline-flex; align-items:center; gap:0.3rem; margin-bottom:0.5rem;" onmouseover="this.style.color='#64748b'" onmouseout="this.style.color='#94a3b8'">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      Kembali
    </a>
    <h1 class="fw-page-title">Tambah Pegawai / Dosen</h1>
    <p class="fw-page-subtitle">Isi formulir di bawah untuk menambahkan data pegawai atau dosen baru</p>
  </div>
</div>

<%# Error alert %>
<% if (errors && errors.length > 0) { %>
  <div class="fw-alert fw-alert-error">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0; margin-top:1px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <div>
      <div style="font-weight:600; margin-bottom:0.25rem;">Terdapat <%= errors.length %> kesalahan</div>
      <ul style="margin:0; padding-left:1rem; font-size:0.8rem;">
        <% errors.forEach(e => { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  </div>
<% } %>

<form method="POST" action="/pegawai">

  <%# Tipe Pegawai %>
  <div class="fw-form-section">
    <div class="fw-form-section-header">
      <span style="font-size:1rem;">👤</span>
      <span class="fw-form-section-title">Tipe Pegawai</span>
    </div>
    <div class="fw-form-section-body">
      <div style="display:flex; gap:1.5rem;">
        <label style="display:flex; align-items:center; gap:0.625rem; cursor:pointer; padding:0.75rem 1.25rem; border:1px solid; border-radius:8px; transition:all 0.15s;" id="type-staf-label">
          <input type="radio" name="employee_type" value="Staf" id="type-staf"
                 <%= (!old.employee_type || old.employee_type === 'Staf') ? 'checked' : '' %>
                 onchange="toggleDosenSection(this.value)" style="accent-color:#3d4158;">
          <div>
            <div style="font-size:0.875rem; font-weight:500;">Staf / Pegawai</div>
            <div style="font-size:0.72rem; color:#94a3b8; margin-top:1px;">Tenaga kependidikan</div>
          </div>
        </label>
        <label style="display:flex; align-items:center; gap:0.625rem; cursor:pointer; padding:0.75rem 1.25rem; border:1px solid; border-radius:8px; transition:all 0.15s;" id="type-dosen-label">
          <input type="radio" name="employee_type" value="Dosen" id="type-dosen"
                 <%= old.employee_type === 'Dosen' ? 'checked' : '' %>
                 onchange="toggleDosenSection(this.value)" style="accent-color:#3d4158;">
          <div>
            <div style="font-size:0.875rem; font-weight:500;">Dosen</div>
            <div style="font-size:0.72rem; color:#94a3b8; margin-top:1px;">Tenaga pengajar/peneliti</div>
          </div>
        </label>
      </div>
    </div>
  </div>

  <%# Data Pribadi %>
  <div class="fw-form-section">
    <div class="fw-form-section-header">
      <span style="font-size:1rem;">🪪</span>
      <span class="fw-form-section-title">Data Pribadi</span>
    </div>
    <div class="fw-form-section-body">
      <div class="fw-grid-2">
        <div class="fw-col-span-2">
          <label class="fw-label fw-label-required">NIP / Nomor Pegawai</label>
          <input type="text" name="employee_number" value="<%= old.employee_number || '' %>"
                 class="fw-input" placeholder="Contoh: 197001012000031001" required
                 inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
          <span class="fw-form-hint">Nomor Induk Pegawai sesuai SK</span>
        </div>
        <div>
          <label class="fw-label fw-label-required">Nama Lengkap</label>
          <input type="text" name="name" value="<%= old.name || '' %>"
                 class="fw-input" placeholder="Nama sesuai KTP" required>
        </div>
        <div>
          <label class="fw-label">No. Telepon</label>
          <input type="text" name="phone_number" value="<%= old.phone_number || '' %>"
                 class="fw-input" placeholder="08xxxxxxxxxx"
                 inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
        </div>
        <div>
          <label class="fw-label">NIK (No. KTP)</label>
          <input type="text" name="national_id_number" value="<%= old.national_id_number || '' %>"
                 class="fw-input" placeholder="16 digit NIK"
                 inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
        </div>
        <div>
          <label class="fw-label">NPWP</label>
          <input type="text" name="tax_id_number" value="<%= old.tax_id_number || '' %>"
                 class="fw-input" placeholder="Nomor NPWP"
                 inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
        </div>
        <div>
          <label class="fw-label fw-label-required">Tempat Lahir</label>
          <input type="text" name="birth_place" value="<%= old.birth_place || '' %>"
                 class="fw-input" placeholder="Kota tempat lahir" required>
        </div>
        <div>
          <label class="fw-label fw-label-required">Tanggal Lahir</label>
          <input type="date" name="birth_date"
                 value="<%= old.birth_date ? new Date(old.birth_date).toISOString().split('T')[0] : '' %>"
                 class="fw-input" required>
        </div>
        <div>
          <label class="fw-label fw-label-required">Jenis Kelamin</label>
          <select name="gender" class="fw-select" required>
            <option value="">- Pilih -</option>
            <option value="male"   <%= old.gender === 'male'   ? 'selected' : '' %>>Laki-laki</option>
            <option value="female" <%= old.gender === 'female' ? 'selected' : '' %>>Perempuan</option>
          </select>
        </div>
        <div>
          <label class="fw-label">Agama</label>
          <select name="religion" class="fw-select">
            <option value="">- Pilih -</option>
            <% ['Islam','Kristen','Katolik','Hindu','Budha','Konghucu'].forEach(r => { %>
              <option value="<%= r %>" <%= old.religion === r ? 'selected' : '' %>><%= r %></option>
            <% }) %>
          </select>
        </div>
        <div class="fw-col-span-2">
          <label class="fw-label fw-label-required">Alamat Lengkap</label>
          <textarea name="address" class="fw-textarea" placeholder="Alamat sesuai KTP" required><%= old.address || '' %></textarea>
        </div>
      </div>
    </div>
  </div>

  <%# Data Kepegawaian %>
  <div class="fw-form-section">
    <div class="fw-form-section-header">
      <span style="font-size:1rem;">🏢</span>
      <span class="fw-form-section-title">Data Kepegawaian</span>
    </div>
    <div class="fw-form-section-body">
      <div class="fw-grid-2">
        <div>
          <label class="fw-label fw-label-required">Unit Organisasi</label>
          <select name="organization_unit_id" class="fw-select" required>
            <option value="">- Pilih Unit -</option>
            <% units.forEach(u => { %>
              <option value="<%= u.id %>" <%= String(old.organization_unit_id) === String(u.id) ? 'selected' : '' %>><%= u.name %></option>
            <% }) %>
          </select>
          <% if (units.length === 0) { %>
            <span class="fw-form-hint" style="color:#f59e0b;">⚠ Data unit organisasi belum tersedia</span>
          <% } %>
        </div>
        <div>
          <label class="fw-label fw-label-required">Status Kepegawaian</label>
          <select name="employment_status_id" class="fw-select" required>
            <option value="">- Pilih Status -</option>
            <% statuses.forEach(s => { %>
              <option value="<%= s.id %>" <%= String(old.employment_status_id) === String(s.id) ? 'selected' : '' %>><%= s.name %></option>
            <% }) %>
          </select>
          <% if (statuses.length === 0) { %>
            <span class="fw-form-hint" style="color:#f59e0b;">⚠ Data status kepegawaian belum tersedia</span>
          <% } %>
        </div>
        <div>
          <label class="fw-label fw-label-required">Tanggal Masuk</label>
          <input type="date" name="hire_date"
                 value="<%= old.hire_date ? new Date(old.hire_date).toISOString().split('T')[0] : '' %>"
                 class="fw-input" required>
        </div>
        <div>
          <label class="fw-label fw-label-required">Status Aktif</label>
          <select name="status" class="fw-select" required>
            <option value="">- Pilih -</option>
            <option value="active"   <%= old.status === 'active'   ? 'selected' : '' %>>Aktif</option>
            <option value="inactive" <%= old.status === 'inactive' ? 'selected' : '' %>>Tidak Aktif</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <%# Data Akademik (Dosen) - kondisional %>
  <div id="dosen-section" class="fw-form-section" style="<%= old.employee_type === 'Dosen' ? '' : 'display:none;' %> border-left:3px solid #3d4158;">
    <div class="fw-form-section-header">
      <div style="display:flex; align-items:center; gap:0.5rem;">
        <span style="font-size:1rem;">🎓</span>
        <span class="fw-form-section-title">Data Akademik</span>
      </div>
      <span class="fw-badge fw-badge-indigo" style="font-size:0.65rem;">Khusus Dosen</span>
    </div>
    <div class="fw-form-section-body">
      <div class="fw-grid-2">
        <div>
          <label class="fw-label">NIDN</label>
          <input type="text" name="nidn" value="<%= old.nidn || '' %>"
                 class="fw-input" placeholder="Nomor Induk Dosen Nasional"
                 inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
        </div>
        <div>
          <label class="fw-label fw-label-required">Pangkat Akademik</label>
          <input type="text" name="academic_rank" value="<%= old.academic_rank || '' %>"
                 class="fw-input" placeholder="Contoh: Lektor Kepala">
        </div>
        <div>
          <label class="fw-label">Jabatan Fungsional</label>
          <input type="text" name="functional_position" value="<%= old.functional_position || '' %>"
                 class="fw-input" placeholder="Contoh: Asisten Ahli">
        </div>
        <div>
          <label class="fw-label">Bidang Keahlian</label>
          <input type="text" name="expertise" value="<%= old.expertise || '' %>"
                 class="fw-input" placeholder="Contoh: Kecerdasan Buatan">
        </div>
      </div>
    </div>
  </div>

  <%# Action buttons %>
  <div style="display:flex; align-items:center; gap:0.75rem; padding-top:0.5rem;">
    <button type="submit" class="fw-btn fw-btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      Kembali
    </a>
  </div>

</form>

<script>
function toggleDosenSection(type) {
  const s = document.getElementById('dosen-section');
  const labelStaf  = document.getElementById('type-staf-label');
  const labelDosen = document.getElementById('type-dosen-label');
  if (type === 'Dosen') {
    s.style.display = '';
    labelDosen.style.borderColor = '#3d4158';
    labelDosen.style.background  = '#eaebf0';
    labelStaf.style.borderColor  = '#e2e8f0';
    labelStaf.style.background   = '#fff';
  } else {
    s.style.display = 'none';
    labelStaf.style.borderColor  = '#3d4158';
    labelStaf.style.background   = '#eaebf0';
    labelDosen.style.borderColor = '#e2e8f0';
    labelDosen.style.background  = '#fff';
  }
}
// Init highlight on load
window.addEventListener('DOMContentLoaded', () => {
  const checked = document.querySelector('input[name="employee_type"]:checked');
  if (checked) toggleDosenSection(checked.value);
});
</script>
